<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
                    xmlns:data="clr-namespace:TPMapEditor.Data"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate DataType="{x:Type data:WorldObject}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Label Margin="-5,0,0,0" Content="Type"/>
                <ComboBox SelectedItem="{Binding Type}" ItemsSource="{x:Static data:WorldObjectType.WotTypes}"/>
                <Label Margin="-5,5,0,0" Content="Position X"/>
                <Slider Value="{Binding X}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                <Label Margin="-5,5,0,0" Content="Position Y"/>
                <Slider Value="{Binding Y}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                <Label Margin="-5,5,0,0" Content="Position Z"/>
                <Slider Value="{Binding Z}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                <Label Margin="-5,5,0,0" Content="Rotation X (Euler XYZ)"/>
                <Slider Value="{Binding XRotation}" IsSnapToTickEnabled="True" Maximum="180" Minimum="-180" TickFrequency="1" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
                <Label Margin="-5,5,0,0" Content="Rotation Y (Euler XYZ)"/>
                <Slider Value="{Binding YRotation}" IsSnapToTickEnabled="True" Maximum="180" Minimum="-180" TickFrequency="1" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
                <Label Margin="-5,5,0,0" Content="Rotation Z (Euler XYZ)"/>
                <Slider Value="{Binding ZRotation}" IsSnapToTickEnabled="True" Maximum="180" Minimum="-180" TickFrequency="1" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
                <CheckBox Margin="0,15,0,0" Content="Has player ?" IsChecked="{Binding HasPlayer}"/>
                <Label Margin="-5,5,0,0" Content="Player"/>
                <ComboBox
                    SelectedItem="{Binding Player}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Map.Players}"
                    IsEnabled="{Binding HasPlayer}">
                </ComboBox>
                <Label Margin="-5,5,0,0" Content="Group"/>
                <CheckBox Content="Is in group ?" IsChecked="{Binding HasGroup}"/>
                <Label Margin="-5,5,0,0" Content="Group"/>
                <ComboBox
                    SelectedItem="{Binding Group}"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Map.Groups}"
                    IsEnabled="{Binding HasGroup}"/>
                <Label Margin="-5,5,0,0" Content="Has state"/>
                <CheckBox IsChecked="{Binding HasState}" Content="{Binding HasState}"/>
                <Label Margin="-5,5,0,0" Content="AIEntity"/>
                <TextBox Text="{Binding AIEntity, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto"/>
                <Label Margin="-5,5,0,0" Content="RenderEntity"/>
                <TextBox Text="{Binding RenderEntity, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto"/>
                <Label Margin="-5,5,0,0" Content="PhysicsEntity"/>
                <TextBox Text="{Binding PhysicsEntity, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto"/>
                <Label Margin="-5,5,0,0" Content="CollisionEntity"/>
                <TextBox Text="{Binding CollisionEntity, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto"/>
                <Label Margin="-5,5,0,0" Content="CustomInfoEntity"/>
                <TextBox Text="{Binding CustomInfoEntity, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>