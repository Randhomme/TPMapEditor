<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:data="clr-namespace:TPMapEditor.Data"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate DataType="{x:Type data:ObjectiveTask}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Label Margin="-5,0,0,0" Content="Name"/>
                <TextBox Text="{Binding Name, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <Label Margin="-5,5,0,0" Content="Task"/>
                <ComboBox ItemsSource="{x:Static data:StringDictionnary.ObjectiveTasks}" SelectedValue="{Binding TextStringId}" SelectedValuePath="Key" DisplayMemberPath="Value"/>
                <Label Margin="-5,5,0,0" Content="Active"/>
                <CheckBox Content="{Binding Active}" IsChecked="{Binding Active}"/>
                <Label Margin="-5,5,0,0" Content="Completed"/>
                <CheckBox Content="{Binding Completed}" IsChecked="{Binding Completed}"/>
                <Label Margin="-5,5,0,0" Content="Failed"/>
                <CheckBox Content="{Binding Failed}" IsChecked="{Binding Failed}"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>