<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
                    xmlns:data="clr-namespace:TPMapEditor.Data"
                    xmlns:vm="clr-namespace:TPMapEditor.ViewModel"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate DataType="{x:Type vm:MultiMapTextPointViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,-5,0,0">
                <StackPanel Visibility="{c:Binding ShowName}">
                    <Label Margin="-5,5,0,0" Content="Name"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                </StackPanel>
                <Label Margin="-5,5,0,0" Content="Displayed text"/>
                <ComboBox ItemsSource="{x:Static data:StringDictionnary.MapTextItems}" SelectedValue="{Binding RealText}" SelectedValuePath="Key" DisplayMemberPath="Value"/>
                <Label Margin="-5,5,0,0" Content="Is visible"/>
                <CheckBox IsChecked="{Binding Visible}" Content="{Binding Visible}"/>
                <ContentPresenter Content="{StaticResource MultiMovable3MapObjectSliders}"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>