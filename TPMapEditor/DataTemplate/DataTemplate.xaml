<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
                    xmlns:converter="clr-namespace:TPMapEditor.Converter"
                    xmlns:data="clr-namespace:TPMapEditor.Data"
                    xmlns:enums="clr-namespace:TPMapEditor.Enums"
                    xmlns:dialogs="clr-namespace:TPMapEditor.Dialogs"
                    x:Class="TPMapEditor.DataTemplate.DataTemplate"
                    >
    <converter:TeamNameConverter x:Key="TeamNameConverter"/>
    <DataTemplate DataType="{x:Type data:WorldObject}">
        <StackPanel>
            <Label Margin="-5,0,0,0" Content="Type"/>
            <ComboBox SelectedItem="{Binding Type}" ItemsSource="{x:Static data:WorldObjectType.WotTypes}"/>
            <Label Margin="-5,5,0,0" Content="Position X"/>
            <Slider Value="{Binding X}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
            <Label Margin="-5,5,0,0" Content="Position Y"/>
            <Slider Value="{Binding Y}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
            <Label Margin="-5,5,0,0" Content="Position Z"/>
            <Slider Value="{Binding Z}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
            <Label Margin="-5,5,0,0" Content="Rotation X (Euler XYZ)"/>
            <Slider Value="{Binding XRotation}" IsSnapToTickEnabled="True" Maximum="180" Minimum="-180" TickFrequency="1" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
            <Label Margin="-5,5,0,0" Content="Rotation Y (Euler XYZ)"/>
            <Slider Value="{Binding YRotation}" IsSnapToTickEnabled="True" Maximum="180" Minimum="-180" TickFrequency="1" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
            <Label Margin="-5,5,0,0" Content="Rotation Z (Euler XYZ)"/>
            <Slider Value="{Binding ZRotation}" IsSnapToTickEnabled="True" Maximum="180" Minimum="-180" TickFrequency="1" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
            <CheckBox Margin="0,15,0,0" Content="Has player ?" IsChecked="{Binding HasPlayer}"/>
            <Label Margin="-5,5,0,0" Content="Player"/>
            <ComboBox
                SelectedItem="{Binding Player}"
                DisplayMemberPath="Name"
                ItemsSource="{Binding Map.Players}"
                IsEnabled="{Binding HasPlayer}"
                SelectedIndex="{c:Binding 'HasPlayer ? 0 : -1', Mode=OneWay}">
            </ComboBox>
            <Label Margin="-5,5,0,0" Content="Group"/>
            <CheckBox Content="Is in group ?" IsChecked="{Binding HasGroup}"/>
            <Label Margin="-5,5,0,0" Content="Group"/>
            <ComboBox
                SelectedItem="{Binding Group}"
                DisplayMemberPath="Name"
                ItemsSource="{Binding Map.Groups}"
                IsEnabled="{Binding HasGroup}"
                SelectedIndex="{c:Binding 'HasGroup ? 0 : -1', Mode=OneWay}"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type data:Player}">
        <StackPanel>
            <Label Margin="-5,0,0,0" Content="Name"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
            <Label Margin="-5,5,0,0" Content="Is playable"/>
            <CheckBox Content="{Binding IsPlayable}" IsChecked="{Binding IsPlayable}" IsEnabled="{c:Binding 'Map.PlayerPlayableCount less 8 or IsPlayable'}"/>
            <Label Margin="-5,5,0,0" Content="Color"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Rectangle>
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="/Images/AlphaBg.png" Stretch="Fill" TileMode="Tile" ViewportUnits="Absolute" ViewboxUnits="RelativeToBoundingBox" Viewport="0,0,10,10" Viewbox="0,0,1,1"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <SolidColorBrush Color="{Binding Color}"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Button Width="70" Content="Edit" Grid.Column="1" Click="EditPlayerColor_Click"/>
            </Grid>
            <Label Margin="-5,5,0,0" Content="Position X"/>
            <Slider Value="{Binding X}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
            <Label Margin="-5,5,0,0" Content="Position Y"/>
            <Slider Value="{Binding Y}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
            <Label Margin="-5,5,0,0" Content="Rotation"/>
            <Slider Value="{Binding Rotation}" Maximum="180" Minimum="-180" TickFrequency="1" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
            <Label Margin="-5,5,0,0" Content="Formation type start"/>
            <ComboBox SelectedItem="{Binding FormationTypeStart}" ItemsSource="{enums:EnumBindingSource enums:FormationType}"/>
            <CheckBox Margin="0,15,0,0" Content="Has selectable team ?" IsChecked="{Binding HasSelectableTeam}"/>
            <Label Margin="-5,5,0,0" Content="Selectable team"/>
            <ComboBox
                SelectedItem="{Binding SelectableTeam}"
                ItemsSource="{Binding Map.SelectableTeams}"
                IsEnabled="{Binding HasSelectableTeam}"
                SelectedIndex="{c:Binding 'HasSelectableTeam ? 0 : -1', Mode=OneWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding RealName, Converter={StaticResource TeamNameConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox Margin="0,15,0,0" Content="Has in game team ?" IsChecked="{Binding HasInGameTeam}"/>
            <Label Margin="-5,5,0,0" Content="In game team"/>
            <ComboBox
                SelectedItem="{Binding InGameTeam}"
                ItemsSource="{Binding Map.InGameTeams}"
                IsEnabled="{Binding HasInGameTeam}"
                SelectedIndex="{c:Binding 'HasInGameTeam ? 0 : -1', Mode=OneWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding RealName, Converter={StaticResource TeamNameConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type data:Group}">
        <StackPanel Visibility="{c:Binding 'CanBeRemoved'}">
            <Label Margin="-5,0,0,0" Content="Name"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
            <Label Margin="-5,5,0,0" Content="Color"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Rectangle>
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="/Images/AlphaBg.png" Stretch="Fill" TileMode="Tile" ViewportUnits="Absolute" ViewboxUnits="RelativeToBoundingBox" Viewport="0,0,10,10" Viewbox="0,0,1,1"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <SolidColorBrush Color="{Binding Color}"/>
                    </Rectangle.Fill>
                </Rectangle>
                <Button Width="70" Content="Edit" Grid.Column="1" Click="EditGroupColor_Click"/>
            </Grid>
            <Label Margin="-5,5,0,0" Content="WorldObjects"/>
            <DataGrid HeadersVisibility="Column" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding WorldObjects}">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="*" Header="Type" Binding="{Binding Type.Type}" CanUserResize="True"/>
                    <DataGridTemplateColumn MinWidth="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove" Click="RemoveWorldObjectFromGroup_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type data:ObjectivePoint}">
        <StackPanel>
            <Label Margin="-5,0,0,0" Content="Name"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
            <Label Margin="-5,5,0,0" Content="Position X"/>
            <Slider Value="{Binding X}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
            <Label Margin="-5,5,0,0" Content="Position Y"/>
            <Slider Value="{Binding Y}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
            <Label Margin="-5,5,0,0" Content="Position Z"/>
            <Slider Value="{Binding Z}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>