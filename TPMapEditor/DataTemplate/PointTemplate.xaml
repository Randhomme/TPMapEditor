<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:data="clr-namespace:TPMapEditor.Data"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate DataType="{x:Type data:Point3}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Grid.Column="2">
                <Label Margin="-5,0,0,0" Content="X"/>
                <Slider Value="{Binding X}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                <Label Margin="-5,5,0,0" Content="Y"/>
                <Slider Value="{Binding Y}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                <Label Margin="-5,5,0,0" Content="Z"/>
                <Slider Value="{Binding Z}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="{x:Type data:Point2}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Grid.Column="2">
                <Label Margin="-5,0,0,0" Content="X"/>
                <Slider Value="{Binding X}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                <Label Margin="-5,5,0,0" Content="Y"/>
                <Slider Value="{Binding Y}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>