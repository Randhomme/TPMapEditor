<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:data="clr-namespace:TPMapEditor.Data"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate DataType="{x:Type data:MapTextPoint}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Label Margin="-5,0,0,0" Content="Name"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                <Label Margin="-5,5,0,0" Content="Displayed text"/>
                <ComboBox ItemsSource="{x:Static data:StringDictionnary.MapTextItems}" SelectedValue="{Binding RealText}" SelectedValuePath="Key" DisplayMemberPath="Value"/>
                <Label Margin="-5,5,0,0" Content="Is visible"/>
                <CheckBox IsChecked="{Binding Visible}" Content="{Binding Visible}"/>
                <Label Margin="-5,5,0,0" Content="Position X"/>
                <Slider Value="{Binding X}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                <Label Margin="-5,5,0,0" Content="Position Y"/>
                <Slider Value="{Binding Y}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                <Label Margin="-5,5,0,0" Content="Position Z"/>
                <Slider Value="{Binding Z}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>