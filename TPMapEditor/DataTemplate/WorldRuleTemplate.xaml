<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:controls="clr-namespace:TPMapEditor.Controls"
                    xmlns:data="clr-namespace:TPMapEditor.Data"
                    xmlns:enums="clr-namespace:TPMapEditor.Enums"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate DataType="{x:Type data:WorldRule}">
        <TabControl>
            <TabItem Header="Properties">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="3">
                        <Label Margin="-5,0,0,0" Content="Name"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                        <CheckBox Margin="0,10" Content="Run once" IsChecked="{Binding RunOnce, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Conditions">
                <controls:CollectionEditorControl Margin="3" ItemsSource="{Binding Conditions}" Factory="{Binding RuleConditionFactory}">
                    <controls:CollectionEditorControl.Columns>
                        <DataGridTextColumn IsReadOnly="True" CanUserSort="False" Binding="{Binding Item.Type, Converter={StaticResource EnumToNameConverter}}" Header="Type" Width="*"/>
                    </controls:CollectionEditorControl.Columns>
                </controls:CollectionEditorControl>
            </TabItem>
            <TabItem Header="Actions">
                <controls:CollectionEditorControl Margin="3" ItemsSource="{Binding Actions}" Factory="{Binding RuleActionFactory}">
                    <controls:CollectionEditorControl.Columns>
                        <DataGridTextColumn IsReadOnly="True" CanUserSort="False" Binding="{Binding Item.Type, Converter={StaticResource EnumToNameConverter}}" Header="Type" Width="*"/>
                    </controls:CollectionEditorControl.Columns>
                </controls:CollectionEditorControl>
            </TabItem>
        </TabControl>
    </DataTemplate>
</ResourceDictionary>