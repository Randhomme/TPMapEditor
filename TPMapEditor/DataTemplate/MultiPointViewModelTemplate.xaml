<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
                    xmlns:vm="clr-namespace:TPMapEditor.ViewModel"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate DataType="{x:Type vm:MultiWaypointPathPointViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,-5,0,0">
                <ContentPresenter Content="{StaticResource MultiMovable3MapObjectSliders}"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MultiWorldPolygonPointViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,-5,0,0">
                <ContentPresenter Content="{StaticResource MultiMovable2MapObjectSliders}"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MultiWorldPointViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,-5,0,0">
                <ContentPresenter Content="{StaticResource MultiMovable3MapObjectSliders}"/>
                <ContentPresenter Content="{StaticResource MultiRotatableMapObjectSliders}"/>
                <Label Margin="-5,5,0,0" Content="Magnitude"/>
                <Slider Value="{Binding Magnitude}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="0" Maximum="9999"/>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>