<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
                    xmlns:data="clr-namespace:TPMapEditor.Data"
                    xmlns:vm="clr-namespace:TPMapEditor.ViewModel"
                    xmlns:enums="clr-namespace:TPMapEditor.Enums"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate DataType="{x:Type vm:MultiPlayerViewModel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,-5,0,0">
                <StackPanel Visibility="{c:Binding ShowName}">
                    <Label Margin="-5,5,0,0" Content="Name"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                </StackPanel>
                <Label Margin="-5,5,0,0" Content="Is playable"/>
                <CheckBox Content="{Binding IsPlayable}" IsChecked="{Binding IsPlayable}" IsEnabled="{c:Binding 'Map.PlayerPlayableCount less 8 or IsPlayable'}"/>
                <ContentPresenter Content="{StaticResource ColoredMapObjectStackPanel}"/>
                <ContentPresenter Content="{StaticResource MultiMovable2MapObjectSliders}"/>
                <ContentPresenter Content="{StaticResource MultiRotatableMapObjectZOnlySliders}"/>
                <Label Margin="-5,5,0,0" Content="Start formation type"/>
                <ComboBox SelectedItem="{Binding FormationTypeStart}" ItemsSource="{enums:EnumBindingSource enums:FormationType}"/>
                <CheckBox Margin="0,15,0,0" Content="Has selectable team ?" IsChecked="{Binding HasSelectableTeam}"/>
                <Label Margin="-5,5,0,0" Content="Selectable team"/>
                <ComboBox
                    SelectedItem="{Binding SelectableTeam}"
                    ItemsSource="{Binding Map.SelectableTeams}"
                    IsEnabled="{Binding HasSelectableTeam}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RealName, Converter={StaticResource TeamNameConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Margin="0,15,0,0" Content="Has in game team ?" IsChecked="{Binding HasInGameTeam}"/>
                <Label Margin="-5,5,0,0" Content="In game team"/>
                <ComboBox
                    SelectedItem="{Binding InGameTeam}"
                    ItemsSource="{Binding Map.InGameTeams}"
                    IsEnabled="{Binding HasInGameTeam}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RealName, Converter={StaticResource TeamNameConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>