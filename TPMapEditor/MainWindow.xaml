                                                <Image Source="/Images/ObjectivePoint.png"/>
                                                <Border.RenderTransform>
                                                    <ScaleTransform
                                                        ScaleX="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.InverseZoom}"
