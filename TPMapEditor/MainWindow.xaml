<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TPMapEditor"
        xmlns:enums="clr-namespace:TPMapEditor.Enums"
        xmlns:converter="clr-namespace:TPMapEditor.Converter"
        xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
        xmlns:controls="clr-namespace:TPMapEditor.Controls"
        xmlns:data="clr-namespace:TPMapEditor.Data"
        xmlns:Styles="clr-namespace:TPMapEditor.Styles" x:Class="TPMapEditor.MainWindow"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Title="TPMapEditor" Height="500" Width="1000" Closing="Window_Closing" Closed="Window_Closed" WindowState="Maximized" UseLayoutRounding="True" ContentRendered="Window_ContentRendered">
    <Window.Resources>
        <converter:TeamNameConverter x:Key="teamNameConverter"/>
        <converter:CenteringMultiConverter x:Key="CenteringMultiConverter"/>
        <converter:Point2EnumerableToPathGeometry x:Key="PathGeometryConverter"/>
        <converter:FillColorConverter x:Key="FillColorConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Row 0 -->
        <Menu>
            <MenuItem Header="File">
                <MenuItem Header="Map">
                    <MenuItem Header="Import" Command="{Binding MapImportCommand}"/>
                    <MenuItem Header="Export"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Map Settings">
                <MenuItem Header="World info" Command="{Binding WorldInfoEditCommand}"/>
                <MenuItem Header="Map size" Command="{Binding MapSizeEditCommand}"/>
                <MenuItem Header="Teams" Command="{Binding TeamsEditCommand}"/>
                <MenuItem Header="Players" Command="{Binding PlayersEditCommand}"/>
                <MenuItem Header="World objects" Command="{Binding WorldObjectsEditCommand}"/>
                <MenuItem Header="Groups" Command="{Binding GroupsEditCommand}"/>
                <MenuItem Header="Flags" Command="{Binding FlagsEditCommand}"/>
                <MenuItem Header="Player alliances" Command="{Binding PlayerAlliancesEditCommand}"/>
                <MenuItem Header="Timers" Command="{Binding TimersEditCommand}"/>
                <MenuItem Header="Speech events" Command="{Binding SpeechEventsEditCommand}"/>
                <MenuItem Header="World rules" Command="{Binding WorldRulesEditCommand}"/>
                <MenuItem Header="Objective tasks" Command="{Binding ObjectiveTasksEditCommand}"/>
                <MenuItem Header="Journal entries" Command="{Binding JournalEntriesEditCommand}"/>
                <MenuItem Header="Waypoint paths" Command="{Binding WaypointPathsEditCommand}"/>
            </MenuItem>
            <MenuItem Header="App">
                <MenuItem Header="Settings" Command="{Binding AppSettingsEditCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Row 1 (Actions and tabs ribbon) -->
        <ScrollViewer Grid.Row="1" Margin="5" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="SelectCheckBox" ToolTip="Select" Margin="0" Width="25" Style="{StaticResource {x:Type ToggleButton}}" IsChecked="True">
                        <Image Margin="2.5" Source="/Images/Default.png"/>
                    </CheckBox>
                    <CheckBox x:Name="MoveCheckBox" ToolTip="Move" Margin="-1,0,0,0" Width="25" Style="{StaticResource {x:Type ToggleButton}}">
                        <Image Margin="2.5" Source="/Images/Move.png"/>
                    </CheckBox>
                    <Button x:Name="DeleteButton" ToolTip="Delete" Margin="-1,0,0,0" Width="25" Content="X" Foreground="Red" Click="DeleteWaypointPathPointButton_Click"/>
                    <Rectangle Width="1" Fill="Gray" Margin="10,0,10,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <RadioButton x:Name="WotRadioButton" Width="95" Height="25" Margin="0" Style="{StaticResource {x:Type ToggleButton}}" Checked="WotRadioButton_Checked" Unchecked="WotRadioButton_Unchecked">
                        <TextBlock Margin="5,0,5,0" Text="World object"/>
                    </RadioButton>
                    <RadioButton x:Name="PlayerRadioButton" Width="95" Height="25" Margin="-1,0,0,0" Style="{StaticResource {x:Type ToggleButton}}" Checked="PlayerRadioButton_Checked" Unchecked="PlayerRadioButton_Unchecked">
                        <TextBlock Margin="5,0,5,0" Text="Player"/>
                    </RadioButton>
                    <RadioButton x:Name="PathRadioButton" Width="95" Height="25" Margin="-1,0,0,0" Style="{StaticResource {x:Type ToggleButton}}" Checked="PathRadioButton_Checked" Unchecked="PathRadioButton_Unchecked">
                        <TextBlock Margin="5,0,5,0" Text="Waypoint path"/>
                    </RadioButton>
                    <RadioButton x:Name="PolygonRadioButton" Width="95" Height="25" Margin="-1,0,0,0" Style="{StaticResource {x:Type ToggleButton}}" Checked="PolygonRadioButton_Checked" Unchecked="PolygonRadioButton_Unchecked">
                        <TextBlock Margin="5,0,5,0" Text="World polygon"/>
                    </RadioButton>
                    <RadioButton x:Name="PointRadioButton" Width="95" Height="25" Margin="-1,0,0,0" Style="{StaticResource {x:Type ToggleButton}}" Checked="PointRadioButton_Checked" Unchecked="PointRadioButton_Unchecked">
                        <TextBlock Margin="5,0,5,0" Text="World point"/>
                    </RadioButton>
                    <RadioButton x:Name="ObjectivePointRadioButton" Width="95" Height="25" Margin="-1,0,0,0" Style="{StaticResource {x:Type ToggleButton}}" Checked="ObjectivePointRadioButton_Checked" Unchecked="ObjectivePointRadioButton_Unchecked">
                        <TextBlock Margin="5,0,5,0" Text="Objective point"/>
                    </RadioButton>
                    <RadioButton x:Name="MapTextPointRadioButton" Width="95" Height="25" Margin="-1,0,0,0" Style="{StaticResource {x:Type ToggleButton}}" Checked="MapTextPointRadioButton_Checked" Unchecked="MapTextPointRadioButton_Unchecked">
                        <TextBlock Margin="5,0,5,0" Text="Map text point"/>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Row 2 (map) -->
        <Grid Grid.Row="2" Margin="5,0,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Column 0 -->
            <ScrollViewer x:Name="MapScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Viewbox x:Name="MapViewBox" Stretch="Uniform" StretchDirection="Both">
                    <Grid x:Name="MapGrid" Background="DarkGray" MouseWheel="Viewbox_MouseWheel">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                        </Grid.LayoutTransform>
                        <Grid Name="MapGridInside" Margin="150" Background="Gray" Width="{Binding Map.Size}" Height="{Binding Map.Size}">
                            
                            <!-- Preview Canvas -->
                            <Canvas x:Name="PreviewCanvas" Panel.ZIndex="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                
                                <!-- Preview WorldObject -->
                                <Border x:Name="WorldObjectPreviewControl" RenderTransformOrigin="0.5,0.5" Visibility="{c:Binding 'SelectedWotGridItem!=null and WotRadioButton.IsChecked==true'}" MouseLeftButtonDown="WorldObjectPreviewControl_MouseLeftButtonDown" MouseRightButtonDown="WorldObjectPreviewControl_MouseRightButtonDown">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="{Binding ElementName=WotSliderRotate, Path=Value}"/>
                                    </Border.RenderTransform>
                                    <Image Source="{Binding SelectedWotGridItem.Image}"/>
                                </Border>
                                
                                <!-- Preview Player -->
                                <Border x:Name="PlayerPreviewControl" RenderTransformOrigin="0.5,0.5" Visibility="{c:Binding ElementName=AddPlayerCheckBox, Path=IsChecked}" MouseLeftButtonDown="PlayerPreviewControl_MouseLeftButtonDown" MouseRightButtonDown="PlayerPreviewControl_MouseRightButtonDown">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="{Binding ElementName=PlayerSliderRotate, Path=Value}"/>
                                    </Border.RenderTransform>
                                    <Image Source="/Images/Player.png"/>
                                </Border>
                            </Canvas>
                            
                            <!-- WorldObjects -->
                            <ItemsControl x:Name="WorldObjectItemsControl" ItemsSource="{Binding Map.WorldObjects}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                    <Binding Path="X" />
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Canvas.Bottom">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                    <Binding Path="Y" />
                                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="border"
                                            BorderThickness="5"
                                            BorderBrush="Transparent"
                                            RenderTransformOrigin="0.5,0.5"
                                            MouseLeftButtonDown="OnWorldObjectClicked">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="{Binding ZRotation}"/>
                                            </Border.RenderTransform>
                                            <Border BorderThickness="2.5">
                                                <Border.BorderBrush>
                                                    <SolidColorBrush Color="{Binding Group.Color}"/>
                                                </Border.BorderBrush>
                                                <Image Source="{Binding Type.Image}"/>
                                            </Border>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="Orange"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Players -->
                            <ItemsControl x:Name="PlayerItemsControl" ItemsSource="{Binding Map.Players}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                    <Binding Path="X" />
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Canvas.Bottom">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                    <Binding Path="Y" />
                                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="border"
                                            BorderThickness="5"
                                            BorderBrush="Transparent"
                                            RenderTransformOrigin="0.5,0.5"
                                            MouseLeftButtonDown="OnPlayerClicked">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="{Binding Rotation}"/>
                                            </Border.RenderTransform>
                                            <Grid>
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="/Images/AlphaBg.png" Stretch="Fill" TileMode="Tile" ViewportUnits="Absolute" ViewboxUnits="RelativeToBoundingBox" Viewport="0,0,10,10" Viewbox="0,0,1,1"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding Color}"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <Image Source="/Images/Player.png" Margin="5"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="Orange"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- WaypointPaths -->
                            <ItemsControl x:Name="WaypointPathItemsControl" ItemsSource="{Binding Map.WaypointPaths}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas>
                                            <!-- Path -->
                                            <Path StrokeThickness="5" Data="{Binding Points, Converter={StaticResource PathGeometryConverter}}">
                                                <Path.RenderTransform>
                                                    <ScaleTransform ScaleY="-1" CenterY="0" />
                                                </Path.RenderTransform>
                                                <Path.Stroke>
                                                    <SolidColorBrush Color="{Binding Color}"/>
                                                </Path.Stroke>
                                            </Path>

                                            <!-- Points -->
                                            <ItemsControl ItemsSource="{Binding Points}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style>
                                                        <Setter Property="Canvas.Left">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                                    <Binding Path="X" />
                                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Canvas.Bottom">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                                    <Binding Path="Y" />
                                                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="border1" Width="30" Height="30" BorderBrush="Transparent" BorderThickness="5" MouseLeftButtonDown="OnWaypointPathPointClicked">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{Binding DataContext.Color, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                            </Border.Background>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="border1" Property="BorderBrush" Value="Orange"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- WorldPolygons -->
                            <ItemsControl x:Name="WorldPolygonItemsControl" ItemsSource="{Binding Map.WorldPolygons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas>
                                            <!-- Path -->
                                            <Path StrokeThickness="5" Data="{Binding Points, Converter={StaticResource PathGeometryConverter}}">
                                                <Path.RenderTransform>
                                                    <ScaleTransform ScaleY="-1" CenterY="0" />
                                                </Path.RenderTransform>
                                                <Path.Stroke>
                                                    <SolidColorBrush Color="{Binding Color}"/>
                                                </Path.Stroke>
                                                <Path.Fill>
                                                    <SolidColorBrush Color="{Binding Color, Converter={StaticResource FillColorConverter}}"/>
                                                </Path.Fill>
                                            </Path>

                                            <!-- Points -->
                                            <ItemsControl ItemsSource="{Binding Points}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemContainerStyle>
                                                    <Style>
                                                        <Setter Property="Canvas.Left">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                                    <Binding Path="X" />
                                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Canvas.Bottom">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                                    <Binding Path="Y" />
                                                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="border1" Width="30" Height="30" BorderBrush="Transparent" BorderThickness="5">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{Binding DataContext.Color, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                            </Border.Background>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="border1" Property="BorderBrush" Value="Orange"/>
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Viewbox>
            </ScrollViewer>

            <!-- Column 1 (right) -->
            <Expander Grid.Column="1" ExpandDirection="Left" IsExpanded="True" Margin="-1">
                <Expander.Header>
                    <TextBlock Text="Actions / Selected object / Mini map" FontSize="14">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Expander.Header>
                <Grid Margin="0,0,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>
                    <GridSplitter Width="5" Margin="5,0,5,0" ResizeBehavior="CurrentAndNext" ResizeDirection="Columns"/>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <TabControl>
                            <TabItem Header="Actions">
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition x:Name="WotGridRow" Height="auto"/>
                                        <RowDefinition x:Name="PlayerGridRow" Height="auto"/>
                                        <RowDefinition x:Name="PathGridRow" Height="auto"/>
                                        <RowDefinition x:Name="PolygonGridRow" Height="auto"/>
                                        <RowDefinition x:Name="PointGridRow" Height="auto"/>
                                        <RowDefinition x:Name="ObjectivePointGridRow" Height="auto"/>
                                        <RowDefinition x:Name="MapTextPointGridRow" Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Visibility="{c:Binding ElementName=WotRadioButton,Path=IsChecked}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <GroupBox Header="Rotation">
                                            <Slider x:Name="WotSliderRotate" Margin="5" Maximum="180" Minimum="-180" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
                                        </GroupBox>
                                        <GroupBox Header="World objects" Grid.Row="1">
                                            <DataGrid x:Name="WotDataGrid" Margin="5" ItemsSource="{x:Static data:WotGridItem.WotTypes}" SelectedItem="{Binding SelectedWotGridItem}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Width="60">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Image Source="{Binding Image}" Stretch="Fill" Width="50" Height="50"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Binding="{Binding Type}" Header="Object type" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </GroupBox>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Visibility="{c:Binding ElementName=PlayerRadioButton,Path=IsChecked}">
                                        <GroupBox Header="Rotation">
                                            <Slider x:Name="PlayerSliderRotate" Margin="5" Maximum="180" Minimum="-180" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
                                        </GroupBox>
                                        <GroupBox Header="Player">
                                            <StackPanel>
                                                <CheckBox x:Name="AddPlayerCheckBox" Content="Player" Margin="5" Style="{StaticResource {x:Type ToggleButton}}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <GroupBox Header="Waypoint path" Grid.Row="2" Visibility="{c:Binding ElementName=PathRadioButton,Path=IsChecked}">
                                        <StackPanel>
                                            <RadioButton x:Name="NewPathRadioButton" Margin="5" Content="New path" Style="{StaticResource {x:Type ToggleButton}}" PreviewMouseDown="RadioButton_PreviewMouseDown"/>
                                            <RadioButton x:Name="AddPointPathRadioButton" Margin="5" Content="Add point" Style="{StaticResource {x:Type ToggleButton}}" PreviewMouseDown="RadioButton_PreviewMouseDown" IsEnabled="{c:Binding 'SelectedPath!=null'}" IsEnabledChanged="RadioButton_IsEnabledChanged"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="World polygon" Grid.Row="3" Visibility="{c:Binding ElementName=PolygonRadioButton,Path=IsChecked}">
                                        <StackPanel>
                                            <RadioButton x:Name="NewPolygonRadioButton" Margin="5" Content="New polygon" Style="{StaticResource {x:Type ToggleButton}}" PreviewMouseDown="RadioButton_PreviewMouseDown"/>
                                            <RadioButton x:Name="AddPointPolygonRadioButton" Margin="5" Content="Add point" Style="{StaticResource {x:Type ToggleButton}}" PreviewMouseDown="RadioButton_PreviewMouseDown" IsEnabled="{c:Binding 'SelectedPolygon!=null'}" IsEnabledChanged="RadioButton_IsEnabledChanged"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <StackPanel Grid.Row="4" Visibility="{c:Binding ElementName=PointRadioButton,Path=IsChecked}">
                                        <GroupBox Header="Rotation">
                                            <Slider x:Name="WorldPointSliderRotate" Margin="5" Maximum="180" Minimum="-180" TickFrequency="1" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
                                        </GroupBox>
                                        <GroupBox Header="World point">
                                            <StackPanel>
                                                <CheckBox x:Name="AddWorldPointCheckBox" Margin="5" Content="New world point" Style="{StaticResource {x:Type ToggleButton}}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <GroupBox Header="Objective point" Grid.Row="5" Visibility="{c:Binding ElementName=ObjectivePointRadioButton,Path=IsChecked}">
                                        <StackPanel>
                                            <CheckBox x:Name="AddObjectivePointCheckBox" Margin="5" Content="New objetive point" Style="{StaticResource {x:Type ToggleButton}}"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Map text point" Grid.Row="6" Visibility="{c:Binding ElementName=MapTextPointRadioButton,Path=IsChecked}">
                                        <StackPanel>
                                            <CheckBox x:Name="AddMapTextPointCheckBox" Margin="5" Content="New objetive point" Style="{StaticResource {x:Type ToggleButton}}"/>
                                        </StackPanel>
                                    </GroupBox>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Selected object">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Grid Visibility="{c:Binding ElementName=WotRadioButton, Path=IsChecked}">
                                            <GroupBox Header="Selected world object" Visibility="{c:Binding 'SelectedWorldObject!=null'}">
                                                <StackPanel Margin="5">
                                                    <GroupBox Header="Type" Padding="0,5,0,0">
                                                        <ComboBox SelectedItem="{Binding SelectedWorldObject.Type}" ItemsSource="{x:Static data:WotGridItem.WotTypes}"/>
                                                    </GroupBox>
                                                    <GroupBox Header="Position">
                                                        <StackPanel>
                                                            <GroupBox Header="X">
                                                                <Slider Value="{Binding SelectedWorldObject.X}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                                                            </GroupBox>
                                                            <GroupBox Header="Y">
                                                                <Slider Value="{Binding SelectedWorldObject.Y}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                                                            </GroupBox>
                                                            <GroupBox Header="Z">
                                                                <Slider Value="{Binding SelectedWorldObject.Z}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                                                            </GroupBox>
                                                        </StackPanel>
                                                    </GroupBox>
                                                    <GroupBox Header="Rotation (Euler XYZ)">
                                                        <StackPanel>
                                                            <GroupBox Header="X">
                                                                <Slider Grid.Column="1" Value="{Binding SelectedWorldObject.XRotation}" IsSnapToTickEnabled="True" Maximum="180" Minimum="-180" TickFrequency="1" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
                                                            </GroupBox>
                                                            <GroupBox Header="Y">
                                                                <Slider Grid.Column="1" Value="{Binding SelectedWorldObject.YRotation}" IsSnapToTickEnabled="True" Maximum="180" Minimum="-180" TickFrequency="1" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
                                                            </GroupBox>
                                                            <GroupBox Header="Z">
                                                                <Slider Grid.Column="1" Value="{Binding SelectedWorldObject.ZRotation}" IsSnapToTickEnabled="True" Maximum="180" Minimum="-180" TickFrequency="1" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
                                                            </GroupBox>
                                                        </StackPanel>
                                                    </GroupBox>
                                                    <GroupBox Header="Player">
                                                        <StackPanel>
