                                            <ComboBox x:Name="MapTextPointPreviewTextComboBox" Margin="5" ItemsSource="{x:Static data:StringDictionnary.MapTextItems}" SelectedIndex="{Binding SelectedMapTextPointPreviewTextIndex}" SelectedValuePath="Value" DisplayMemberPath="Value"/>
