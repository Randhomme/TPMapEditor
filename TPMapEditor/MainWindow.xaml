                                        </StackPanel>
                                    </GroupBox>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Selected object">
                                <Grid>
                                    <Grid Visibility="{c:Binding ElementName=WorldObjectRadioButton, Path=IsChecked}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
