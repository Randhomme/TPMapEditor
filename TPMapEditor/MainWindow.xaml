                                            <RadioButton x:Name="NewWorldPolygonRadioButton" Margin="5" Content="New polygon" Style="{StaticResource {x:Type ToggleButton}}" PreviewMouseDown="RadioButton_PreviewMouseDown"/>
                                            <RadioButton x:Name="AddWorldPolygonPointRadioButton" Margin="5" Content="Add point" Style="{StaticResource {x:Type ToggleButton}}" PreviewMouseDown="RadioButton_PreviewMouseDown" IsEnabled="{c:Binding 'WorldPolygonSelectionService.SelectedMapObject!=null'}" IsEnabledChanged="RadioButton_IsEnabledChanged"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <StackPanel Grid.Row="4" Visibility="{c:Binding ElementName=WorldPointSetRadioButton, Path=IsChecked}">
