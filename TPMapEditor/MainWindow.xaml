                                        <ItemsPanelTemplate>
                                            <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style>
                                            <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas>
                                                <!-- Points -->
                                                <ItemsControl x:Name="Points" ItemsSource="{Binding Points}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>

                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style>
                                                            <Setter Property="Canvas.Left">
                                                                <Setter.Value>
                                                                    <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                                        <Binding Path="X" />
                                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                                    </MultiBinding>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="Canvas.Bottom">
                                                                <Setter.Value>
                                                                    <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                                        <Binding Path="Y" />
                                                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                                                    </MultiBinding>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>

                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="border" RenderTransformOrigin="0.5,0.5" BorderBrush="Transparent" BorderThickness="2.5" PreviewMouseLeftButtonDown="OnWorldPointClicked">
                                                                <Border x:Name="borderInside" Width="20" Height="20" BorderThickness="2.5">
                                                                    <Border.Background>
                                                                        <SolidColorBrush Color="{Binding Parent.Color}"/>
                                                                    </Border.Background>
                                                                    <Image Source="/Images/Arrow.png"/>
                                                                </Border>
                                                                <Border.RenderTransform>
                                                                    <TransformGroup>
                                                                        <RotateTransform Angle="{Binding ZRotation}"/>
                                                                        <ScaleTransform
                                                                            ScaleX="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.InverseZoom}"
                                                                            ScaleY="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.InverseZoom}"/>
                                                                    </TransformGroup>
                                                                </Border.RenderTransform>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Parent.IsLastSelected}" Value="True">
                                                                    <Setter TargetName="borderInside" Property="BorderBrush" Value="Orange"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter TargetName="border" Property="BorderBrush" Value="OrangeRed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsLastSelected}" Value="True">
                                                                    <Setter TargetName="border" Property="BorderBrush" Value="Orange"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Canvas>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsShownOnUi}" Value="False">
                                                    <Setter TargetName="Points" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

