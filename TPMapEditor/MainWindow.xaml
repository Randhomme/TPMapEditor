                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- MapTextPoints -->
                                <ItemsControl x:Name="MapTextPointItemsControl" ItemsSource="{Binding Map.MapTextPoints}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style>
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                        <Binding Path="X" />
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Bottom">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                        <Binding Path="Y" />
                                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="border"
                                                BorderThickness="2.5"
                                                BorderBrush="Transparent"
                                                RenderTransformOrigin="0.5,0.5"
                                                PreviewMouseLeftButtonDown="OnMapTextPointClicked">
                                                <Border.RenderTransform>
                                                    <ScaleTransform
                                                        ScaleX="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.InverseZoom}"
                                                        ScaleY="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.InverseZoom}"/>
                                                </Border.RenderTransform>
                                                <TextBlock x:Name="DisplayedTextBlock" Text="{Binding DisplayedText}" Foreground="Khaki"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
