<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TPMapEditor"
        xmlns:enums="clr-namespace:TPMapEditor.Enums"
        xmlns:converter="clr-namespace:TPMapEditor.Converter"
        xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
        xmlns:controls="clr-namespace:TPMapEditor.Controls"
        xmlns:data="clr-namespace:TPMapEditor.Data"
        xmlns:vm="clr-namespace:TPMapEditor.ViewModel"
        xmlns:Styles="clr-namespace:TPMapEditor.Styles" x:Class="TPMapEditor.MainWindow"
        mc:Ignorable="d"
        Title="TPMapEditor" Height="500" Width="1000" Closing="Window_Closing" Closed="Window_Closed" WindowState="Maximized" UseLayoutRounding="True" PreviewKeyDown="Window_PreviewKeyDown" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded">
    <Window.Resources>
        <converter:CenteringMultiConverter x:Key="CenteringMultiConverter"/>
        <converter:Point2EnumerableToPathGeometry x:Key="PathGeometryConverter"/>
        <converter:FillColorConverter x:Key="FillColorConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Row 0 -->
        <Menu>
            <MenuItem Header="File">
                <MenuItem Header="Map">
                    <MenuItem Header="Import" Command="{Binding MapImportCommand}"/>
                    <MenuItem Header="Export" Command="{Binding MapExportCommand}"/>
                </MenuItem>
                <MenuItem Header="Starmap">
                    <MenuItem Header="Export" Command="{Binding StarmapExportCommand}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Map Settings" >
                <MenuItem Header="Reset map" Command="{Binding ResetMapCommand}"/>
                <Separator/>
                <MenuItem Header="Map size" Command="{Binding MapSizeEditCommand}"/>
                <MenuItem Header="World info" Command="{Binding WorldInfoEditCommand}"/>
                <Separator/>
                <MenuItem Header="Flags" Command="{Binding FlagsEditCommand}"/>
                <MenuItem Header="Groups" Command="{Binding GroupsEditCommand}"/>
                <MenuItem Header="Journal entries" Command="{Binding JournalEntriesEditCommand}"/>
                <MenuItem Header="Map text points" Command="{Binding MapTextPointsEditCommand}"/>
                <MenuItem Header="Objective tasks" Command="{Binding ObjectiveTasksEditCommand}"/>
                <MenuItem Header="Objective points" Command="{Binding ObjectivePointsEditCommand}"/>
                <MenuItem Header="Players" Command="{Binding PlayersEditCommand}"/>
                <MenuItem Header="Player alliances" Command="{Binding PlayerAlliancesEditCommand}"/>
                <MenuItem Header="Teams" Command="{Binding TeamsEditCommand}"/>
                <MenuItem Header="Speech events" Command="{Binding SpeechEventsEditCommand}"/>
                <MenuItem Header="Timers" Command="{Binding TimersEditCommand}"/>
                <MenuItem Header="Waypoint paths" Command="{Binding WaypointPathsEditCommand}"/>
                <MenuItem Header="World crews and arms" Command="{Binding WorldCrewsAndArmsEditCommand}"/>
                <MenuItem Header="World objects" Command="{Binding WorldObjectsEditCommand}"/>
                <MenuItem Header="World point sets" Command="{Binding WorldPointSetsEditCommand}"/>
                <MenuItem Header="World polygons" Command="{Binding WorldPolygonsEditCommand}"/>
                <MenuItem Header="World rules" Command="{Binding WorldRulesEditCommand}"/>
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Transform">
                    <MenuItem Header="Align" Command="{Binding AlignTransformCommand}"/>
                    <MenuItem Header="Distribute" Command="{Binding DistributeTransformCommand}"/>
                    <MenuItem Header="Move" Command="{Binding TranslateTransformCommand}"/>
                </MenuItem>
                <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}"/>
                <MenuItem Header="Redo" InputGestureText="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
            </MenuItem>
            <MenuItem Header="App">
                <MenuItem Header="Settings" Command="{Binding AppSettingsEditCommand}"/>
                <MenuItem Header="Reload">
                    <MenuItem Header="Dialogue files" Command="{Binding ReloadDialogueFilesListCommand}"/>
                    <MenuItem Header="Effects" Command="{Binding ReloadEffectListCommand}"/>
                    <MenuItem Header="Flag textures" Command="{Binding ReloadFlagTexturesListCommand}"/>
                    <MenuItem Header="Gui textures" Command="{Binding ReloadGuiTexturesListCommand}"/>
                    <MenuItem Header="Hud.hdt textures" Command="{Binding ReloadHudTexturesListCommand}"/>
                    <MenuItem Header="Meshes" Command="{Binding ReloadMeshesListCommand}"/>
                    <MenuItem Header="Musics" Command="{Binding ReloadMusicsListCommand}"/>
                    <MenuItem Header="Singleplayer missions" Command="{Binding ReloadSinglePlayerMissionsListCommand}"/>
                    <MenuItem Header="Strings" Command="{Binding ReloadStringsCommand}"/>
                    <MenuItem Header="World object types" Command="{Binding ReloadWorldObjectTypeListCommand}"/>
                    <Separator/>
                    <MenuItem Header="Reload all" Command="{Binding ReloadAllCommand}"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="Wiki" Command="{Binding WikiCommand}"/>
                <MenuItem Header="Changelogs" Command="{Binding ChangelogsCommand}"/>
                <MenuItem Header="About" Command="{Binding AboutAppShowCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Row 1 (Actions and tabs ribbon) -->
        <ScrollViewer Grid.Row="1" Margin="5" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="SelectCheckBox" ToolTip="Select" Margin="0" Width="25" Style="{StaticResource {x:Type ToggleButton}}" IsChecked="True">
                        <Image Margin="2.5" Source="/Images/Default.png"/>
                    </CheckBox>
                    <CheckBox x:Name="MoveCheckBox" ToolTip="Move" Margin="-1,0,0,0" Width="25" Style="{StaticResource {x:Type ToggleButton}}">
                        <Image Margin="2.5" Source="/Images/Move.png"/>
                    </CheckBox>
                    <CheckBox x:Name="RotateCheckBox" ToolTip="Rotate" Margin="-1,0,0,0" Width="25" Style="{StaticResource {x:Type ToggleButton}}">
                        <Image Margin="2.5" Source="/Images/Rotate.png"/>
                    </CheckBox>
                    <Button x:Name="DeleteButton" ToolTip="Delete" Margin="-1,0,0,0" Width="25">
                        <Image Source="/Images/RedCross.png"/>
                    </Button>
                    <Grid>
                        <StackPanel Orientation="Horizontal" Visibility="{c:Binding ElementName=WorldObjectRadioButton, Path=IsChecked}" IsEnabled="{c:Binding 'WorldObjectSelectionService.SelectedMapObject!=null'}" ToolTip="Z index">
                            <Button ToolTip="Decrease Z index" Margin="10,0,-1,0" Width="25" Content="-" Command="{Binding DecreaseZIndexCommand}" CommandParameter="{Binding WorldObjectSelectionService.SelectedMapObject}"/>
                            <TextBox Margin="0" Width="25" Panel.ZIndex="-1" Text="{Binding WorldObjectSelectionService.SelectedMapObject.ZIndex}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            <Button ToolTip="Increase Z index" Margin="-1,0,0,0" Width="25" Content="+" Command="{Binding IncreaseZIndexCommand}" CommandParameter="{Binding WorldObjectSelectionService.SelectedMapObject}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{c:Binding ElementName=PlayerRadioButton, Path=IsChecked}" IsEnabled="{c:Binding 'PlayerSelectionService.SelectedMapObject!=null'}" ToolTip="Z index">
                            <Button ToolTip="Decrease Z index" Margin="10,0,-1,0" Width="25" Content="-" Command="{Binding DecreaseZIndexCommand}" CommandParameter="{Binding PlayerSelectionService.SelectedMapObject}"/>
                            <TextBox Margin="0" Width="25" Panel.ZIndex="-1" Text="{Binding PlayerSelectionService.SelectedMapObject.ZIndex}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            <Button ToolTip="Increase Z index" Margin="-1,0,0,0" Width="25" Content="+" Command="{Binding IncreaseZIndexCommand}" CommandParameter="{Binding PlayerSelectionService.SelectedMapObject}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{c:Binding ElementName=WaypointPathRadioButton, Path=IsChecked}" IsEnabled="{c:Binding 'WaypointPathSelectionService.SelectedMapObject!=null'}" ToolTip="Z index">
                            <Button ToolTip="Decrease Z index" Margin="10,0,-1,0" Width="25" Content="-" Command="{Binding DecreaseZIndexCommand}" CommandParameter="{Binding WaypointPathSelectionService.SelectedMapObject}"/>
                            <TextBox Margin="0" Width="25" Panel.ZIndex="-1" Text="{Binding WaypointPathSelectionService.SelectedMapObject.ZIndex}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            <Button ToolTip="Increase Z index" Margin="-1,0,0,0" Width="25" Content="+" Command="{Binding IncreaseZIndexCommand}" CommandParameter="{Binding WaypointPathSelectionService.SelectedMapObject}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{c:Binding ElementName=WorldPolygonRadioButton, Path=IsChecked}" IsEnabled="{c:Binding 'WorldPolygonSelectionService.SelectedMapObject!=null'}" ToolTip="Z index">
                            <Button ToolTip="Decrease Z index" Margin="10,0,-1,0" Width="25" Content="-" Command="{Binding DecreaseZIndexCommand}" CommandParameter="{Binding WorldPolygonSelectionService.SelectedMapObject}"/>
                            <TextBox Margin="0" Width="25" Panel.ZIndex="-1" Text="{Binding WorldPolygonSelectionService.SelectedMapObject.ZIndex}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            <Button ToolTip="Increase Z index" Margin="-1,0,0,0" Width="25" Content="+" Command="{Binding IncreaseZIndexCommand}" CommandParameter="{Binding WorldPolygonSelectionService.SelectedMapObject}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{c:Binding ElementName=WorldPointSetRadioButton, Path=IsChecked}" IsEnabled="{c:Binding 'WorldPointSetSelectionService.SelectedMapObject!=null'}" ToolTip="Z index">
                            <Button ToolTip="Decrease Z index" Margin="10,0,-1,0" Width="25" Content="-" Command="{Binding DecreaseZIndexCommand}" CommandParameter="{Binding WorldPointSetSelectionService.SelectedMapObject}"/>
                            <TextBox Margin="0" Width="25" Panel.ZIndex="-1" Text="{Binding WorldPointSetSelectionService.SelectedMapObject.ZIndex}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            <Button ToolTip="Increase Z index" Margin="-1,0,0,0" Width="25" Content="+" Command="{Binding IncreaseZIndexCommand}" CommandParameter="{Binding WorldPointSetSelectionService.SelectedMapObject}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{c:Binding ElementName=ObjectivePointRadioButton, Path=IsChecked}" IsEnabled="{c:Binding 'ObjectivePointSelectionService.SelectedMapObject!=null'}" ToolTip="Z index">
                            <Button ToolTip="Decrease Z index" Margin="10,0,-1,0" Width="25" Content="-" Command="{Binding DecreaseZIndexCommand}" CommandParameter="{Binding ObjectivePointSelectionService.SelectedMapObject}"/>
                            <TextBox Margin="0" Width="25" Panel.ZIndex="-1" Text="{Binding ObjectivePointSelectionService.SelectedMapObject.ZIndex}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            <Button ToolTip="Increase Z index" Margin="-1,0,0,0" Width="25" Content="+" Command="{Binding IncreaseZIndexCommand}" CommandParameter="{Binding ObjectivePointSelectionService.SelectedMapObject}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{c:Binding ElementName=MapTextPointRadioButton, Path=IsChecked}" IsEnabled="{c:Binding 'MapTextPointSelectionService.SelectedMapObject!=null'}" ToolTip="Z index">
                            <Button ToolTip="Decrease Z index" Margin="10,0,-1,0" Width="25" Content="-" Command="{Binding DecreaseZIndexCommand}" CommandParameter="{Binding MapTextPointSelectionService.SelectedMapObject}"/>
                            <TextBox Margin="0" Width="25" Panel.ZIndex="-1" Text="{Binding MapTextPointSelectionService.SelectedMapObject.ZIndex}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            <Button ToolTip="Increase Z index" Margin="-1,0,0,0" Width="25" Content="+" Command="{Binding IncreaseZIndexCommand}" CommandParameter="{Binding MapTextPointSelectionService.SelectedMapObject}"/>
                        </StackPanel>
                    </Grid>
                    <Rectangle Width="1" Fill="Gray" Margin="10,0,10,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="1">
                    <RadioButton x:Name="WorldObjectRadioButton" Width="95" Height="25" Margin="0" Style="{StaticResource {x:Type ToggleButton}}" Checked="WorldObjectRadioButton_Checked" Unchecked="WorldObjectRadioButton_Unchecked">
                        <TextBlock Margin="5,0,5,0" Text="World object"/>
                    </RadioButton>
                    <RadioButton x:Name="PlayerRadioButton" Width="95" Height="25" Margin="-1,0,0,0" Style="{StaticResource {x:Type ToggleButton}}" Checked="PlayerRadioButton_Checked" Unchecked="PlayerRadioButton_Unchecked">
                        <TextBlock Margin="5,0,5,0" Text="Player"/>
                    </RadioButton>
                    <RadioButton x:Name="WaypointPathRadioButton" Width="95" Height="25" Margin="-1,0,0,0" Style="{StaticResource {x:Type ToggleButton}}" Checked="WaypointPathRadioButton_Checked" Unchecked="WaypointPathRadioButton_Unchecked">
                        <TextBlock Margin="5,0,5,0" Text="Waypoint path"/>
                    </RadioButton>
                    <RadioButton x:Name="WorldPolygonRadioButton" Width="95" Height="25" Margin="-1,0,0,0" Style="{StaticResource {x:Type ToggleButton}}" Checked="WorldPolygonRadioButton_Checked" Unchecked="WorldPolygonRadioButton_Unchecked">
                        <TextBlock Margin="5,0,5,0" Text="World polygon"/>
                    </RadioButton>
                    <RadioButton x:Name="WorldPointSetRadioButton" Width="95" Height="25" Margin="-1,0,0,0" Style="{StaticResource {x:Type ToggleButton}}" Checked="WorldPointRadioButton_Checked" Unchecked="WorldPointRadioButton_Unchecked">
                        <TextBlock Margin="5,0,5,0" Text="World point set"/>
                    </RadioButton>
                    <RadioButton x:Name="ObjectivePointRadioButton" Width="95" Height="25" Margin="-1,0,0,0" Style="{StaticResource {x:Type ToggleButton}}" Checked="ObjectivePointRadioButton_Checked" Unchecked="ObjectivePointRadioButton_Unchecked">
                        <TextBlock Margin="5,0,5,0" Text="Objective point"/>
                    </RadioButton>
                    <RadioButton x:Name="MapTextPointRadioButton" Width="95" Height="25" Margin="-1,0,0,0" Style="{StaticResource {x:Type ToggleButton}}" Checked="MapTextPointRadioButton_Checked" Unchecked="MapTextPointRadioButton_Unchecked">
                        <TextBlock Margin="5,0,5,0" Text="Map text point"/>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Row 2 (map) -->
        <Grid Grid.Row="2" Margin="5,0,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0 -->
            <ScrollViewer x:Name="MapScrollViewer" CanContentScroll="False" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="MapScrollViewer_PreviewMouseWheel">
                <Grid x:Name="MapGridOutside" Background="Transparent" MouseWheel="Viewbox_MouseWheel">
                    <Viewbox x:Name="MapViewBox" Stretch="Uniform" StretchDirection="Both">
                        <Grid x:Name="MapGrid" UseLayoutRounding="False" Background="DarkGray" ClipToBounds="True" Width="{Binding Map.Size}" Height="{Binding Map.Size}">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="ZoomTransform" ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                            </Grid.LayoutTransform>
                            <Grid Name="MapGridInside" Margin="{Binding Map.WorldBuffer}" Background="Gray">

                                <!-- Preview Canvas -->
                                <Canvas x:Name="PreviewCanvas" Panel.ZIndex="2" HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <!-- Selection Rectangle-->
                                    <Rectangle x:Name="SelectionRectangle" Stroke="OrangeRed" StrokeThickness="{Binding ZoomedBorderThicknessSmall}" Width="0" Height="0"/>

                                    <!-- Preview WorldObject -->
                                    <Border x:Name="WorldObjectPreviewControl" BorderThickness="{Binding ZoomedBorderThicknessSmall}" RenderTransformOrigin="{Binding SelectedWorldObjectType.Pivot}" Visibility="{c:Binding 'SelectedWorldObjectType!=null'}" PreviewMouseLeftButtonUp="WorldObjectPreviewControl_MouseLeftButtonDown" MouseRightButtonDown="WorldObjectPreviewControl_MouseRightButtonDown" MouseWheel="WorldObjectPreviewControl_MouseWheel">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="{Binding ElementName=WotSliderRotate, Path=Value}"/>
                                        </Border.RenderTransform>
                                        <Image Source="{Binding SelectedWorldObjectType.Image}"/>
                                    </Border>

                                    <!-- Preview Player -->
                                    <Border x:Name="PlayerPreviewControl" Width="20" Height="20" RenderTransformOrigin="0.5,0.5" Visibility="{c:Binding ElementName=AddPlayerCheckBox, Path=IsChecked}" PreviewMouseLeftButtonUp="PlayerPreviewControl_MouseLeftButtonDown" MouseRightButtonDown="PlayerPreviewControl_MouseRightButtonDown" MouseWheel="PlayerPreviewControl_MouseWheel">
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform Angle="{Binding ElementName=PlayerSliderRotate, Path=Value}"/>
                                                <ScaleTransform
                                                    ScaleX="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.InverseZoom}"
                                                    ScaleY="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.InverseZoom}"/>
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                        <Image Source="/Images/Player.png"/>
                                    </Border>

                                    <!-- Preview Path -->
                                    <Border x:Name="WaypointPathPreviewControl" Width="15" Height="15" RenderTransformOrigin="0.5,0.5" BorderThickness="2.5" Background="Black" Visibility="{c:Binding ElementName=NewWaypointPathRadioButton, Path=IsChecked}" PreviewMouseLeftButtonUp="WaypointPathPreviewControl_MouseLeftButtonDown" MouseRightButtonDown="WaypointPathPreviewControl_MouseRightButtonDown">
                                        <Border.RenderTransform>
                                            <ScaleTransform
                                                ScaleX="{Binding InverseZoom}"
                                                ScaleY="{Binding InverseZoom}"/>
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="WaypointPathPointPreviewControl" Width="15" Height="15" RenderTransformOrigin="0.5,0.5" BorderThickness="2.5" Background="Black" Visibility="{c:Binding ElementName=AddWaypointPathPointRadioButton, Path=IsChecked}" PreviewMouseLeftButtonUp="WaypointPathPointPreviewControl_MouseLeftButtonDown" MouseRightButtonDown="WaypointPathPointPreviewControl_MouseRightButtonDown">
                                        <Border.RenderTransform>
                                            <ScaleTransform
                                                ScaleX="{Binding InverseZoom}"
                                                ScaleY="{Binding InverseZoom}"/>
                                        </Border.RenderTransform>
                                    </Border>

                                    <!-- Preview Polygon -->
                                    <Border x:Name="WorldPolygonPreviewControl" Width="15" Height="15" RenderTransformOrigin="0.5,0.5" BorderThickness="2.5" Background="Black" Visibility="{c:Binding ElementName=NewWorldPolygonRadioButton, Path=IsChecked}" PreviewMouseLeftButtonUp="WorldPolygonPreviewControl_MouseLeftButtonDown" MouseRightButtonDown="WorldPolygonPreviewControl_MouseRightButtonDown">
                                        <Border.RenderTransform>
                                            <ScaleTransform
                                                ScaleX="{Binding InverseZoom}"
                                                ScaleY="{Binding InverseZoom}"/>
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="WorldPolygonPointPreviewControl" Width="15" Height="15" RenderTransformOrigin="0.5,0.5" BorderThickness="2.5" Background="Black" Visibility="{c:Binding ElementName=AddWorldPolygonPointRadioButton, Path=IsChecked}" PreviewMouseLeftButtonUp="WorldPolygonPointPreviewControl_MouseLeftButtonDown" MouseRightButtonDown="WorldPolygonPointPreviewControl_MouseRightButtonDown">
                                        <Border.RenderTransform>
                                            <ScaleTransform
                                                ScaleX="{Binding InverseZoom}"
                                                ScaleY="{Binding InverseZoom}"/>
                                        </Border.RenderTransform>
                                    </Border>

                                    <!-- Preview PointSet -->
                                    <Border x:Name="WorldPointSetPreviewControl" Width="15" Height="15" RenderTransformOrigin="0.5,0.5" BorderThickness="2.5" Background="Black" Visibility="{c:Binding ElementName=AddWorldPointSetRadioButton, Path=IsChecked}" PreviewMouseLeftButtonUp="WorldPointSetPreviewControl_MouseLeftButtonDown" MouseRightButtonDown="WorldPointSetPreviewControl_MouseRightButtonDown" MouseWheel="WorldPointPreviewControl_MouseWheel">
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform Angle="{Binding ElementName=WorldPointSliderRotate, Path=Value}"/>
                                                <ScaleTransform ScaleX="{Binding InverseZoom}" ScaleY="{Binding InverseZoom}"/>
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                        <Image Source="/Images/Arrow.png"/>
                                    </Border>
                                    <Border x:Name="WorldPointPreviewControl" Width="15" Height="15" BorderThickness="2.5" RenderTransformOrigin="0.5,0.5" Background="Black" Visibility="{c:Binding ElementName=AddWorldPointSetPointRadioButton, Path=IsChecked}" PreviewMouseLeftButtonUp="WorldPointPreviewControl_MouseLeftButtonDown" MouseRightButtonDown="WorldPointPreviewControl_MouseRightButtonDown" MouseWheel="WorldPointPreviewControl_MouseWheel">
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform Angle="{Binding ElementName=WorldPointSliderRotate, Path=Value}"/>
                                                <ScaleTransform
                                                    ScaleX="{Binding InverseZoom}"
                                                    ScaleY="{Binding InverseZoom}"/>
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                        <Image Source="/Images/Arrow.png"/>
                                    </Border>

                                    <!-- Preview ObjectivePoint -->
                                    <Border x:Name="ObjectivePointPreviewControl" Width="30" Height="30" BorderThickness="2.5" RenderTransformOrigin="0.5,0.5" Visibility="{c:Binding ElementName=AddObjectivePointCheckBox, Path=IsChecked}" PreviewMouseLeftButtonUp="ObjectivePointPreviewControl_MouseLeftButtonDown" MouseRightButtonDown="ObjectivePointPreviewControl_MouseRightButtonDown">
                                        <Image Source="/Images/ObjectivePoint.png"/>
                                        <Border.RenderTransform>
                                            <ScaleTransform
                                                ScaleX="{Binding InverseZoom}"
                                                ScaleY="{Binding InverseZoom}"/>
                                        </Border.RenderTransform>
                                    </Border>

                                    <!-- Preview MapTextPoint -->
                                    <Border x:Name="MapTextPointPreviewControl" RenderTransformOrigin="0.5,0.5" Visibility="{c:Binding ElementName=AddMapTextPointCheckBox, Path=IsChecked}" PreviewMouseLeftButtonUp="MapTextPointPreviewControl_MouseLeftButtonDown" MouseRightButtonDown="MapTextPointPreviewControl_MouseRightButtonDown">
                                        <Border.RenderTransform>
                                            <ScaleTransform
                                                ScaleX="{Binding InverseZoom}"
                                                ScaleY="{Binding InverseZoom}"/>
                                        </Border.RenderTransform>
                                        <TextBlock x:Name="MapTextPointPreviewTextBlock" Text="{Binding ElementName=MapTextPointPreviewTextComboBox, Path=SelectedValue}" Foreground="Khaki"/>
                                    </Border>
                                </Canvas>

                                <!-- WorldObjects -->
                                <ItemsControl x:Name="WorldObjectItemsControl" ItemsSource="{Binding Map.WorldObjects}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style>
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                        <Binding Path="X" />
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Bottom">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                        <Binding Path="Y" />
                                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="border"
                                                BorderThickness="2.5"
                                                BorderBrush="Transparent"
                                                RenderTransformOrigin="{Binding Type.Pivot}"
                                                PreviewMouseLeftButtonDown="OnWorldObjectClicked">
                                                <Border.RenderTransform>
                                                    <RotateTransform Angle="{Binding ZRotation}"/>
                                                </Border.RenderTransform>
                                                <Border BorderThickness="2.5">
                                                    <Border.BorderBrush>
                                                        <SolidColorBrush Color="{Binding Group.Color}"/>
                                                    </Border.BorderBrush>
                                                    <Image Source="{Binding Type.Image}"/>
                                                </Border>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="border" Property="BorderBrush" Value="OrangeRed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLastSelected}" Value="True">
                                                    <Setter TargetName="border" Property="BorderBrush" Value="Orange"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsShownOnUi}" Value="False">
                                                    <Setter TargetName="border" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Players -->
                                <ItemsControl x:Name="PlayerItemsControl" ItemsSource="{Binding Map.Players}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style>
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                        <Binding Path="X" />
                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Bottom">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                        <Binding Path="Y" />
                                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="border"
                                                Width="30" Height="30"
                                                BorderThickness="2.5"
                                                BorderBrush="Transparent"
                                                RenderTransformOrigin="0.5,0.5"
                                                PreviewMouseLeftButtonDown="OnPlayerClicked">
                                                <Border.RenderTransform>
                                                    <TransformGroup>
                                                        <RotateTransform Angle="{Binding Rotation}"/>
                                                        <ScaleTransform
                                                            ScaleX="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.InverseZoom}"
                                                            ScaleY="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.InverseZoom}"/>
                                                    </TransformGroup>
                                                </Border.RenderTransform>
                                                <Grid>
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="/Images/AlphaBg.png" Stretch="Fill" TileMode="Tile" ViewportUnits="Absolute" ViewboxUnits="RelativeToBoundingBox" Viewport="0,0,10,10" Viewbox="0,0,1,1"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <SolidColorBrush Color="{Binding Color}"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <Image Source="/Images/Player.png" Margin="2.5"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
