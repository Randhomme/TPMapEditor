                                                <DataTrigger Binding="{Binding IsShownOnUi}" Value="False">
                                                    <Setter TargetName="Path" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsShownOnUi}" Value="False">
                                                    <Setter TargetName="Points" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- WorldPointSets -->
                                <ItemsControl x:Name="WorldPointSetItemsControl" ItemsSource="{Binding Map.WorldPointSets}">
