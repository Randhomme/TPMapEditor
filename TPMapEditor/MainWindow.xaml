                                                <!-- Path -->
                                                <Path x:Name="OutlinePath" StrokeThickness="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.ZoomedBorderThicknessLarge}" Data="{Binding Points, Converter={StaticResource PathGeometryConverter}}" Visibility="{c:Binding IsSelected}">
