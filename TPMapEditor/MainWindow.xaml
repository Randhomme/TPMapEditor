                                        <GroupBox Header="World objects" Grid.Row="1">
                                            <DataGrid x:Name="WotDataGrid" Margin="5" ItemsSource="{Binding SelectableWorldObjectTypes}" SelectedItem="{Binding SelectedWorldObjectType}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Width="60">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Image Source="{Binding Image}" Stretch="Fill" Width="50" Height="50"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Binding="{Binding Name}" Header="Object type" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </GroupBox>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Visibility="{c:Binding ElementName=PlayerRadioButton, Path=IsChecked}">
                                        <GroupBox Header="Rotation">
                                            <Slider x:Name="PlayerSliderRotate" Margin="5" Maximum="180" Minimum="-180" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
                                        </GroupBox>
                                        <GroupBox Header="Player">
                                            <StackPanel>
                                                <CheckBox x:Name="AddPlayerCheckBox" Content="Player" Margin="5" Style="{StaticResource {x:Type ToggleButton}}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                    <GroupBox Header="Waypoint path" Grid.Row="2" Visibility="{c:Binding ElementName=WaypointPathRadioButton, Path=IsChecked}">
                                        <StackPanel>
                                            <RadioButton x:Name="NewWaypointPathRadioButton" Margin="5" Content="New path" Style="{StaticResource {x:Type ToggleButton}}" PreviewMouseDown="RadioButton_PreviewMouseDown"/>
                                            <RadioButton x:Name="AddWaypointPathPointRadioButton" Margin="5" Content="Add point" Style="{StaticResource {x:Type ToggleButton}}" PreviewMouseDown="RadioButton_PreviewMouseDown" IsEnabled="{c:Binding 'WaypointPathSelectionService.SelectedMapObject!=null'}" IsEnabledChanged="RadioButton_IsEnabledChanged"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="World polygon" Grid.Row="3" Visibility="{c:Binding ElementName=WorldPolygonRadioButton, Path=IsChecked}">
