                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLastSelected}" Value="True">
                                                    <Setter TargetName="border" Property="BorderBrush" Value="Orange"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Visible}" Value="False">
                                                    <Setter TargetName="DisplayedTextBlock" Property="TextDecorations">
                                                        <Setter.Value>
                                                            <TextDecorationCollection>
                                                                <TextDecoration Location="Strikethrough" PenOffsetUnit="Pixel" PenOffset="-1"/>
                                                            </TextDecorationCollection>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsShownOnUi}" Value="False">
                                                    <Setter TargetName="border" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Viewbox>
                </Grid>
            </ScrollViewer>

            <!-- Column 1 (right) -->
            <Expander Grid.Column="1" ExpandDirection="Left" IsExpanded="True" Margin="-1">
                <Expander.Header>
                    <TextBlock Text="Actions / Selected object / Mini map" FontSize="14">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Expander.Header>
                <Grid Margin="0,0,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="250"/>
                    </Grid.ColumnDefinitions>
                    <GridSplitter Width="5" Margin="5,0,5,0" ResizeBehavior="CurrentAndNext" ResizeDirection="Columns"/>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <TabControl>
                            <TabItem Header="Actions">
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition x:Name="WorldObjectGridRow" Height="auto"/>
                                        <RowDefinition x:Name="PlayerGridRow" Height="auto"/>
                                        <RowDefinition x:Name="WaypointPathGridRow" Height="auto"/>
                                        <RowDefinition x:Name="WorldPolygonGridRow" Height="auto"/>
                                        <RowDefinition x:Name="WorldPointSetGridRow" Height="auto"/>
                                        <RowDefinition x:Name="ObjectivePointGridRow" Height="auto"/>
                                        <RowDefinition x:Name="MapTextPointGridRow" Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Visibility="{c:Binding ElementName=WorldObjectRadioButton,Path=IsChecked}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <GroupBox Header="Rotation">
                                            <Slider x:Name="WotSliderRotate" Margin="5" Maximum="180" Minimum="-180" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
