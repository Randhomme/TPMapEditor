<local:DialogWindow x:Class="TPMapEditor.Dialogs.WorldObjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TPMapEditor.Dialogs"
        xmlns:data="clr-namespace:TPMapEditor.Data"
        xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="WorldObjectDialog" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="2*" MinWidth="200"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <DataGrid HeadersVisibility="Column" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding Map.WorldObjects}" SelectedItem="{Binding SelectedWorldObject}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Type}" Header="Type" Width="*"/>
                        <DataGridTemplateColumn MinWidth="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove" Click="RemoveWorldObject_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Margin="0,5,0,0" Grid.Row="1" MinWidth="85" Content="Add world object" Command="{Binding AddWorldObjectCommand}"/>
            </Grid>
            <GridSplitter Grid.Column="1" Margin="5,0,5,0" Width="5" ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="{c:Binding 'SelectedWorldObject!=null'}">
                <StackPanel>
                    <Label Margin="-5,0,0,0" Content="Type"/>
                    <ComboBox SelectedItem="{Binding SelectedWorldObject.Type}" ItemsSource="{x:Static data:WotGridItem.WotTypes}"/>
                    <Label Margin="-5,5,0,0" Content="Position X"/>
                    <Slider Value="{Binding SelectedWorldObject.X}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                    <Label Margin="-5,5,0,0" Content="Position Y"/>
                    <Slider Value="{Binding SelectedWorldObject.Y}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                    <Label Margin="-5,5,0,0" Content="Position Z"/>
                    <Slider Value="{Binding SelectedWorldObject.Z}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                    <Label Margin="-5,5,0,0" Content="Rotation X (Euler XYZ)"/>
                    <Slider Value="{Binding SelectedWorldObject.XRotation}" IsSnapToTickEnabled="True" Maximum="180" Minimum="-180" TickFrequency="1" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
                    <Label Margin="-5,5,0,0" Content="Rotation Y (Euler XYZ)"/>
                    <Slider Value="{Binding SelectedWorldObject.YRotation}" IsSnapToTickEnabled="True" Maximum="180" Minimum="-180" TickFrequency="1" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
                    <Label Margin="-5,5,0,0" Content="Rotation Z (Euler XYZ)"/>
                    <Slider Value="{Binding SelectedWorldObject.ZRotation}" IsSnapToTickEnabled="True" Maximum="180" Minimum="-180" TickFrequency="1" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
                    <CheckBox x:Name="wotHasPlayer" Margin="0,15,0,0" Content="Has player ?" IsChecked="{c:Binding Path='SelectedWorldObject.Player!= null', Mode=OneWay}"/>
                    <Label Margin="-5,5,0,0" Content="Player"/>
                    <ComboBox
                        x:Name="teamComboBox"
                        SelectedItem="{Binding SelectedWorldObject.Player}"
                        ItemsSource="{Binding Map.Players}"
                        IsEnabled="{Binding ElementName=wotHasPlayer, Path=IsChecked}"
                        SelectedIndex="{c:Binding ElementName=wotHasPlayer, Path='IsChecked ? 0 : -1', Mode=OneWay}">
                    </ComboBox>
                    <Label Margin="-5,5,0,0" Content="Group"/>
                    <CheckBox x:Name="wotIsInGroup" Content="Is in group ?" IsChecked="{c:Binding Mode=OneWay, Path='SelectedWorldObject.Group != null', UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Margin="-5,5,0,0" Content="Group"/>
                    <ComboBox
                        SelectedItem="{Binding SelectedWorldObject.Group}"
                        ItemsSource="{Binding Map.Groups}"
                        IsEnabled="{Binding IsChecked, ElementName=wotIsInGroup}"
                        SelectedIndex="{c:Binding ElementName=wotIsInGroup, Mode=OneWay, Path=IsChecked ? 0 : -1}"
                        DisplayMemberPath="Name"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
            <Button Content="Close" MinWidth="85" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</local:DialogWindow>
