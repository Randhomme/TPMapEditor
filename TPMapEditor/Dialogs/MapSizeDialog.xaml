<local:DialogWindow x:Class="TPMapEditor.Dialogs.MapSizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TPMapEditor.Dialogs"
        xmlns:TPMapEditor="clr-namespace:TPMapEditor"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="Map size" Height="330" Width="430">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Label Margin="-5,0,0,0" Content="Size" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <TextBox x:Name="TextSize" IsEnabled="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Slider Margin="0,5,0,0" x:Name="SliderSize" Value="{Binding Size, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Maximum="6000" SmallChange="1" TickFrequency="2" ValueChanged="SliderSize_ValueChanged" Height="22" IsSnapToTickEnabled="True"/>
            <Label Margin="-5,5,0,0" Content="Z Size" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <TextBox x:Name="TextZSize" IsEnabled="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Slider Margin="0,5,0,0" x:Name="SliderZSize" Value="{Binding ZSize, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Maximum="6000" SmallChange="1" TickFrequency="2" ValueChanged="SliderZSize_ValueChanged" Height="22" IsSnapToTickEnabled="True"/>
            <Label Margin="-5,5,0,0" Content="World buffer" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <TextBox x:Name="TextWorldBuffer" IsEnabled="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Slider Margin="0,5,0,0" x:Name="SliderWorldBuffer" Value="{Binding WorldBuffer, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Minimum="0" Maximum="9999" SmallChange="1" TickFrequency="1" ValueChanged="SliderWorldBuffer_ValueChanged" Height="22" IsSnapToTickEnabled="True"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Save" Margin="0,0,15,0" MinWidth="85" IsDefault="True" Click="SaveButton_Click"/>
            <Button Content="Cancel" MinWidth="85" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</local:DialogWindow>
