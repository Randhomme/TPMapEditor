<local:DialogWindow x:Class="TPMapEditor.Dialogs.ColorPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TPMapEditor.Dialogs"
        xmlns:myStyles="clr-namespace:TPMapEditor.Styles"
        xmlns:converter="clr-namespace:TPMapEditor.Converter"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Height="auto" Width="auto" SizeToContent="WidthAndHeight" Loaded="myWindow_Loaded">
    <Window.Resources>
        <Color x:Key="SelectedHueColor" A="255" R="255"/>
        <Style x:Key="mySlider" TargetType="{x:Type Slider}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="25" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" 
                    Height="{TemplateBinding Slider.Height}" 
                    MinHeight="25"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Border Margin="5" Background="{TemplateBinding Background}" BorderBrush="Gray" BorderThickness="1"/>
                            </Border>
                            <Track Grid.Row="0" Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Grid Margin="1,0,1,0" Background="Transparent">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="10" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="10" />
                                                    </Grid.RowDefinitions>
                                                    <Image Grid.Row="0" Width="10">
                                                        <Image.Source>
                                                            <DrawingImage>
                                                                <DrawingImage.Drawing>
                                                                    <GeometryDrawing Geometry="M 25 50 L 0 0 50 0 Z">
                                                                        <GeometryDrawing.Pen>
                                                                            <Pen Brush="Black" Thickness="30" LineJoin="Round"/>
                                                                        </GeometryDrawing.Pen>
                                                                    </GeometryDrawing>
                                                                </DrawingImage.Drawing>
                                                            </DrawingImage>
                                                        </Image.Source>
                                                    </Image>
                                                    <Image Grid.Row="2" Width="10">
                                                        <Image.Source>
                                                            <DrawingImage>
                                                                <DrawingImage.Drawing>
                                                                    <GeometryDrawing Geometry="M 25 0 L 0 50 50 50 Z">
                                                                        <GeometryDrawing.Pen>
                                                                            <Pen Brush="Black" Thickness="30" LineJoin="Round"/>
                                                                        </GeometryDrawing.Pen>
                                                                    </GeometryDrawing>
                                                                </DrawingImage.Drawing>
                                                            </DrawingImage>
                                                        </Image.Source>
                                                    </Image>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Slider x:Name="hueSlider" Style="{StaticResource mySlider}" ValueChanged="hueSlider_ValueChanged" Maximum="1529" SmallChange="1" IsSnapToTickEnabled="True" PreviewMouseLeftButtonDown="hueSlider_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="hueSlider_PreviewMouseLeftButtonUp">
                    <Slider.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="Red" Offset="0"/>
                            <GradientStop Color="Yellow" Offset="0.166"/>
                            <GradientStop Color="Lime" Offset="0.333"/>
                            <GradientStop Color="Cyan" Offset="0.5"/>
                            <GradientStop Color="Blue" Offset="0.666"/>
                            <GradientStop Color="Magenta" Offset="0.833"/>
                            <GradientStop Color="Red" Offset="1"/>
                        </LinearGradientBrush>
                    </Slider.Background>
                </Slider>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="250"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Border Margin="5" BorderBrush="Gray" BorderThickness="1" Grid.Row="1">
                        <Grid>
                            <Grid.Background>
                                <ImageBrush ImageSource="/Images/AlphaBg.png" ViewportUnits="Absolute" TileMode="Tile" Viewport="0,0,10,10"/>
                            </Grid.Background>
                            <Grid Background="Black" Opacity="{Binding ElementName=aSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}">
                                <Rectangle x:Name="colorPreview">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="{DynamicResource SelectedHueColor}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.OpacityMask>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Offset="0" Color="#FF000000"/>
                                            <GradientStop Offset="1" Color="#00FFFFFF"/>
                                        </LinearGradientBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>
                            <Canvas ClipToBounds="False" x:Name="colorCanvas" Background="Transparent" MouseDown="colorCanvas_MouseDown" MouseUp="colorCanvas_MouseUp" SizeChanged="colorCanvas_SizeChanged">
                                <Border x:Name="colorHandle" Width="10" Height="10" BorderBrush="White" BorderThickness="1" CornerRadius="10">
                                    <Border BorderBrush="Black" BorderThickness="1" CornerRadius="10">
                                        <Ellipse Stroke="White" StrokeThickness="1"/>
                                    </Border>
                                </Border>
                            </Canvas>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="5,0,5,5">
                        <GroupBox x:Name="aGroupBox" Header="Alpha">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="aSlider" Maximum="255" SmallChange="1" IsSnapToTickEnabled="True" ValueChanged="rgbaSlider_ValueChanged" Visibility="Collapsed"/>
                                <TextBox Grid.Column="1" myStyles:SelectTextOnFocus.Active="True"  Text="{Binding ElementName=aSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}" BorderBrush="{x:Null}"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Red">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="rSlider" Maximum="255" SmallChange="1" IsSnapToTickEnabled="True" ValueChanged="rgbaSlider_ValueChanged" Visibility="Collapsed"/>
                                <TextBox Grid.Column="1" myStyles:SelectTextOnFocus.Active="True" Text="{Binding ElementName=rSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Transparent"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Green">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="gSlider" Maximum="255" SmallChange="1" IsSnapToTickEnabled="True" ValueChanged="rgbaSlider_ValueChanged" Visibility="Collapsed"/>
                                <TextBox Grid.Column="1" myStyles:SelectTextOnFocus.Active="True" Text="{Binding ElementName=gSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Transparent"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Blue">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="bSlider" Maximum="255" SmallChange="1" IsSnapToTickEnabled="True" ValueChanged="rgbaSlider_ValueChanged" Visibility="Collapsed"/>
                                <TextBox Grid.Column="1" myStyles:SelectTextOnFocus.Active="True" Text="{Binding ElementName=bSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}" BorderBrush="Transparent"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Hex">
                            <TextBox x:Name="hexColorTextBox" myStyles:SelectTextOnFocus.Active="True" BorderBrush="{x:Null}" TextChanged="hexColorTextBox_TextChanged"/>
                        </GroupBox>
                    </StackPanel>
                </Grid>

                <Grid Margin="5" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="Old color">
                        <Grid>
                            <Grid.Background>
                                <ImageBrush ImageSource="/Images/AlphaBg.png" ViewportUnits="Absolute" TileMode="Tile" Viewport="0,0,10,10"/>
                            </Grid.Background>
                            <Rectangle Height="25" MinWidth="25" Stroke="Gray">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{Binding CurrentColor}"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="New color" Grid.Column="1">
                        <Grid>
                            <Grid.Background>
                                <ImageBrush ImageSource="/Images/AlphaBg.png" ViewportUnits="Absolute" TileMode="Tile" Viewport="0,0,10,10"/>
                            </Grid.Background>
                            <Rectangle x:Name="newColorRectangle" Height="25" MinWidth="25" Stroke="Gray">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{Binding NewColor}"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </GroupBox>
                </Grid>
            </Grid>
        </ScrollViewer>
        <StackPanel Margin="15" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Save" Margin="0,0,15,0" MinWidth="85" IsDefault="True" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="85" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</local:DialogWindow>
