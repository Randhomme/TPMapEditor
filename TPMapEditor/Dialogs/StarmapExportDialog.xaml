<local:DialogWindow x:Class="TPMapEditor.Dialogs.StarmapExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TPMapEditor.Dialogs"
        xmlns:converter="clr-namespace:TPMapEditor.Converter"
        mc:Ignorable="d"
        Title="StarmapExportDialog" SizeToContent="WidthAndHeight">
    <Window.Resources>
        <converter:CenteringMultiConverter x:Key="CenteringMultiConverter"/>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="DarkGray">
            <Grid Background="Gray" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox x:Name="MapViewbox" Stretch="Uniform" StretchDirection="Both" Width="512" Height="512">
                    <Grid ClipToBounds="True">
                        <Grid UseLayoutRounding="False" Margin="{Binding NegativeWorldBuffer}" Width="{Binding Map.Size}" Height="{Binding Map.Size}">
                            <ItemsControl ItemsSource="{Binding BlackHoles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                    <Binding Path="X" />
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Canvas.Bottom">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                    <Binding Path="Y" />
                                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid RenderTransformOrigin="{Binding Type.Pivot}">
                                            <Grid.RenderTransform>
                                                <RotateTransform Angle="{Binding ZRotation}"/>
                                            </Grid.RenderTransform>
                                            <Image Source="{Binding Type.Image}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding StarmapWorldObjects}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style>
                                        <Setter Property="Canvas.Left">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                    <Binding Path="X" />
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Canvas.Bottom">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                    <Binding Path="Y" />
                                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid RenderTransformOrigin="{Binding Type.Pivot}">
                                            <Grid.RenderTransform>
                                                <RotateTransform Angle="{Binding ZRotation}"/>
                                            </Grid.RenderTransform>
                                            <Image Source="{Binding Type.Image}" Visibility="Hidden" Margin="0" Stretch="Uniform" StretchDirection="Both"/>
                                            <Rectangle Fill="White" Margin="-10">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="{Binding Type.Image}" Stretch="Uniform"/>
                                                </Rectangle.OpacityMask>
                                                <Rectangle.Effect>
                                                    <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="50" Opacity="1"/>
                                                </Rectangle.Effect>
                                            </Rectangle>
                                            <Rectangle Fill="Black" Margin="-5">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="{Binding Type.Image}" Stretch="Uniform"/>
                                                </Rectangle.OpacityMask>
                                                <Rectangle.Effect>
                                                    <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="50" Opacity="1"/>
                                                </Rectangle.Effect>
                                            </Rectangle>
                                            <Rectangle Margin="0">
                                                <Rectangle.Fill>
                                                    <RadialGradientBrush RadiusX="1.5" RadiusY="1.5" Center="{Binding Type.Pivot}">
                                                        <RadialGradientBrush.GradientStops>
                                                            <GradientStop Offset="0" Color="Aqua"/>
                                                            <GradientStop Offset="1" Color="Black"/>
                                                        </RadialGradientBrush.GradientStops>
                                                    </RadialGradientBrush>
                                                </Rectangle.Fill>
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="{Binding Type.Image}" Stretch="Uniform"/>
                                                </Rectangle.OpacityMask>
                                                <Rectangle.Effect>
                                                    <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="50" Opacity="1"/>
                                                </Rectangle.Effect>
                                            </Rectangle>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Viewbox>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
            <Button Margin="0,0,15,0" Content="Export" MinWidth="85" Click="ExportButton_Click"/>
            <Button Content="Close" MinWidth="85" Click="SaveButton_Click" IsCancel="True" IsDefault="True"/>
        </StackPanel>
    </Grid>
</local:DialogWindow>
