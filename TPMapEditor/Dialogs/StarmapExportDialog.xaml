<local:DialogWindow x:Class="TPMapEditor.Dialogs.StarmapExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TPMapEditor.Dialogs"
        xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
        xmlns:base="clr-namespace:TPMapEditor"
        xmlns:converter="clr-namespace:TPMapEditor.Converter"
        mc:Ignorable="d"
        SizeToContent="WidthAndHeight" Closing="DialogWindow_Closing">
    <Window.Resources>
        <converter:CenteringMultiConverter x:Key="CenteringMultiConverter"/>
        <converter:Point2EnumerableToPathGeometry x:Key="PathGeometryConverter"/>
        <converter:Point2EnumerableToPathRoundedGeometry x:Key="Point2EnumerableToPathRoundedGeometry"/>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="DarkGray">
            <Grid>
                <Grid Width="512" Height="512">
                    <TextBlock Text="Loading ..." HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Grid Background="Gray" Visibility="{c:Binding IsReady}">
                    <Grid>
                        <Grid.Background>
                            <ImageBrush ImageSource="/Images/bg.png"/>
                        </Grid.Background>
                        <Grid Width="512" Height="512" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas x:Name="MapGrid">
                                <Canvas.OpacityMask>
                                    <VisualBrush>
                                        <VisualBrush.Visual>
                                            <Rectangle Fill="White" Width="512" Height="512">
                                                <Rectangle.Effect>
                                                    <BlurEffect Radius="20" KernelType="Box" />
                                                </Rectangle.Effect>
                                            </Rectangle>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Canvas.OpacityMask>
                                <Viewbox x:Name="MapViewbox" ClipToBounds="True" Stretch="Uniform" StretchDirection="Both" Width="512" Height="512" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Grid Background="Transparent" UseLayoutRounding="True" Margin="{Binding NegativeWorldBuffer}" Width="{Binding Map.Size}" Height="{Binding Map.Size}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding EtheriumCurrents}" >
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Canvas>
                                                        <Canvas.Effect>
                                                            <DropShadowEffect ShadowDepth="0" Color="PaleGreen" BlurRadius="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.IslandShadowBlurRadius}"/>
                                                        </Canvas.Effect>
                                                        <Path Data="{Binding Path.Points, Converter={StaticResource Point2EnumerableToPathRoundedGeometry}}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="White" StrokeThickness="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.NebulaBlurRadius}">
                                                            <Path.RenderTransform>
                                                                <ScaleTransform ScaleY="-1" CenterY="0" />
                                                            </Path.RenderTransform>
                                                            <Path.Effect>
                                                                <DropShadowEffect ShadowDepth="0" Opacity="1" Color="Black" BlurRadius="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.BorderThickness}"/>
                                                            </Path.Effect>
                                                        </Path>
                                                        <Path Data="{Binding Path.Points, Converter={StaticResource Point2EnumerableToPathRoundedGeometry}}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="Lime" StrokeThickness="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.EtheriumCurrentThickness}">
                                                            <Path.RenderTransform>
                                                                <ScaleTransform ScaleY="-1" CenterY="0" />
                                                            </Path.RenderTransform>
                                                            <Path.Effect>
                                                                <DropShadowEffect ShadowDepth="0" Color="Black" BlurRadius="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.IslandInnerShadowBlurRadius}"/>
                                                            </Path.Effect>
                                                        </Path>
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Canvas HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas.Effect>
                                                <DropShadowEffect Color="Aquamarine" ShadowDepth="0" BlurRadius="{Binding IslandShadowBlurRadius}" Opacity="1"/>
                                            </Canvas.Effect>
                                            <ItemsControl ItemsSource="{Binding Islands}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Canvas.Effect>
                                                                <DropShadowEffect Color="LightGreen" ShadowDepth="0" BlurRadius="{Binding IslandShadowBlurRadius}" Opacity="1"/>
                                                            </Canvas.Effect>
                                                        </Canvas>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style>
                                                        <Setter Property="Canvas.Left">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                                    <Binding Path="X" />
                                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Canvas.Bottom">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                                    <Binding Path="Y" />
                                                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid >
                                                            <Image Source="{Binding StarmapImage}" RenderTransformOrigin="0.5,0.5" Margin="0">
                                                                <Image.RenderTransform>
                                                                    <TransformGroup>
                                                                        <TranslateTransform X="{Binding Pivot.X}" Y="{Binding Pivot.Y}"/>
                                                                        <RotateTransform Angle="{Binding ZRotation}"/>
                                                                    </TransformGroup>
                                                                </Image.RenderTransform>
                                                                <Image.Effect>
                                                                    <DropShadowEffect ShadowDepth="0" Opacity="0.5" Color="Black" BlurRadius="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.EtheriumCurrentShadowThickness}"/>
                                                                </Image.Effect>
                                                            </Image>
                                                            <Rectangle Fill="DarkSlateGray" RenderTransformOrigin="0.5,0.5" Margin="0">
                                                                <Rectangle.RenderTransform>
                                                                    <TransformGroup>
                                                                        <TranslateTransform X="{Binding Pivot.X}" Y="{Binding Pivot.Y}"/>
                                                                        <RotateTransform Angle="{Binding ZRotation}"/>
                                                                    </TransformGroup>
                                                                </Rectangle.RenderTransform>
                                                                <Rectangle.OpacityMask>
                                                                    <ImageBrush ImageSource="{Binding OriginalImage}" Stretch="None"/>
                                                                </Rectangle.OpacityMask>
                                                                <Rectangle.Effect>
                                                                    <DropShadowEffect ShadowDepth="0" Color="DarkSlateGray" BlurRadius="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.IslandInnerShadowBlurRadius}"/>
                                                                </Rectangle.Effect>
                                                            </Rectangle>
                                                            <Rectangle Fill="DarkSlateGray" RenderTransformOrigin="0.5,0.5" Margin="0">
                                                                <Rectangle.RenderTransform>
                                                                    <TransformGroup>
                                                                        <TranslateTransform X="{Binding Pivot.X}" Y="{Binding Pivot.Y}"/>
                                                                        <RotateTransform Angle="{Binding ZRotation}"/>
                                                                    </TransformGroup>
                                                                </Rectangle.RenderTransform>
                                                                <Rectangle.OpacityMask>
                                                                    <ImageBrush ImageSource="{Binding OriginalImage}" Stretch="None"/>
                                                                </Rectangle.OpacityMask>
                                                                <Rectangle.Effect>
                                                                    <DropShadowEffect ShadowDepth="0" Color="DarkSlateGray" BlurRadius="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.IslandInnerShadowBlurRadius}"/>
                                                                </Rectangle.Effect>
                                                            </Rectangle>
                                                            <Rectangle RenderTransformOrigin="0.5,0.5" Margin="0">
                                                                <Rectangle.RenderTransform>
                                                                    <TransformGroup>
                                                                        <TranslateTransform X="{Binding Pivot.X}" Y="{Binding Pivot.Y}"/>
                                                                        <RotateTransform Angle="{Binding ZRotation}"/>
                                                                        <!--<ScaleTransform ScaleX="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.ScaleDownTransformIsland}" ScaleY="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.ScaleDownTransformIsland}"/>-->
                                                                        <!--<TranslateTransform X="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.TranslateTransformIsland}" Y="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.TranslateTransformIsland}"/>-->
                                                                    </TransformGroup>
                                                                </Rectangle.RenderTransform>
                                                                <Rectangle.OpacityMask>
                                                                    <ImageBrush ImageSource="{Binding OriginalImage}" Stretch="None"/>
                                                                </Rectangle.OpacityMask>
                                                                <Rectangle.Effect>
                                                                    <DropShadowEffect ShadowDepth="0" Color="DarkSlateGray" BlurRadius="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.IslandInnerShadowBlurRadius}"/>
                                                                </Rectangle.Effect>
                                                                <Rectangle.Fill>
                                                                    <RadialGradientBrush RadiusX="1" RadiusY="1">
                                                                        <GradientStop Color="Cyan" Offset="0.25"/>
                                                                        <GradientStop Color="DarkCyan" Offset="0.75"/>
                                                                    </RadialGradientBrush>
                                                                </Rectangle.Fill>
                                                            </Rectangle>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Canvas>
                                        <ItemsControl ItemsSource="{Binding BlackHoles}" Panel.ZIndex="1">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Canvas.Effect>
                                                            <DropShadowEffect BlurRadius="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.EtheriumCurrentThickness}" Color="MediumAquamarine" ShadowDepth="0"/>
                                                        </Canvas.Effect>
                                                    </Canvas>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style>
                                                    <Setter Property="Canvas.Left">
                                                        <Setter.Value>
                                                            <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                                <Binding Path="X" />
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="Canvas.Bottom">
                                                        <Setter.Value>
                                                            <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                                <Binding Path="Y" />
                                                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding OriginalImage}" RenderTransformOrigin="0.5,0.5">
                                                        <Image.RenderTransform>
                                                            <TransformGroup>
                                                                <TranslateTransform X="{Binding Pivot.X}" Y="{Binding Pivot.Y}"/>
                                                                <RotateTransform Angle="{Binding ZRotation}"/>
                                                            </TransformGroup>
                                                        </Image.RenderTransform>
                                                        <Image.Effect>
                                                            <DropShadowEffect BlurRadius="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.EtheriumCurrentThickness}" Color="MediumSeaGreen" ShadowDepth="0"/>
                                                        </Image.Effect>
                                                    </Image>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Asteroids}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Canvas.Effect>
                                                            <DropShadowEffect BlurRadius="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.EtheriumCurrentThickness}" Color="LimeGreen" ShadowDepth="0"/>
                                                        </Canvas.Effect>
                                                    </Canvas>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style>
                                                    <Setter Property="Canvas.Left">
                                                        <Setter.Value>
                                                            <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                                <Binding Path="X" />
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="Canvas.Bottom">
                                                        <Setter.Value>
                                                            <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                                <Binding Path="Y" />
                                                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Image Source="{Binding StarmapImage}" RenderTransformOrigin="0.5,0.5">
                                                            <Image.RenderTransform>
                                                                <TransformGroup>
                                                                    <TranslateTransform X="{Binding Pivot.X}" Y="{Binding Pivot.Y}"/>
                                                                    <RotateTransform Angle="{Binding ZRotation}"/>
                                                                </TransformGroup>
                                                            </Image.RenderTransform>
                                                            <Image.Effect>
                                                                <DropShadowEffect BlurRadius="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.BorderThickness}" Color="Green" ShadowDepth="0" Opacity="1"/>
                                                            </Image.Effect>
                                                        </Image>
                                                        <Rectangle Fill="Lime" RenderTransformOrigin="0.5,0.5" >
                                                            <Rectangle.RenderTransform>
                                                                <TransformGroup>
                                                                    <TranslateTransform X="{Binding Pivot.X}" Y="{Binding Pivot.Y}"/>
                                                                    <RotateTransform Angle="{Binding ZRotation}"/>
                                                                </TransformGroup>
                                                            </Rectangle.RenderTransform>
                                                            <Rectangle.OpacityMask>
                                                                <ImageBrush ImageSource="{Binding OriginalImage}" Stretch="None"/>
                                                            </Rectangle.OpacityMask>
                                                            <!--<Rectangle.Effect>
                                                                <DropShadowEffect ShadowDepth="0" Color="Lime" BlurRadius="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.BorderThickness}"/>
                                                            </Rectangle.Effect>-->
                                                        </Rectangle>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Nebulas}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Path x:Name="Path" Data="{Binding Polygon.Points, Converter={StaticResource Point2EnumerableToPathRoundedGeometry}}">
                                                        <Path.RenderTransform>
                                                            <ScaleTransform ScaleY="-1" CenterY="0" />
                                                        </Path.RenderTransform>
                                                        <Path.Fill>
                                                            <ImageBrush ImageSource="/Images/Nebula.png" TileMode="Tile" Stretch="UniformToFill" ViewportUnits="Absolute" Viewport="0,0,300,300" Opacity="1"/>
                                                        </Path.Fill>
                                                        <Path.OpacityMask>
                                                            <VisualBrush>
                                                                <VisualBrush.Visual>
                                                                    <Path Data="{Binding Polygon.Points, Converter={StaticResource PathGeometryConverter}}" Fill="Black">
                                                                        <Path.Effect>
                                                                            <BlurEffect Radius="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.NebulaBlurRadius}" KernelType="Box"/>
                                                                        </Path.Effect>
                                                                    </Path>
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Path.OpacityMask>
                                                    </Path>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Viewbox>
                            </Canvas>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
            <Button Margin="0,0,15,0" Content="Export" MinWidth="85" Click="ExportButton_Click" IsEnabled="{Binding IsReady}"/>
            <Button Content="Close" MinWidth="85" Click="SaveButton_Click" IsCancel="True" IsDefault="True"/>
        </StackPanel>
    </Grid>
</local:DialogWindow>
