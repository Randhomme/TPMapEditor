<local:DialogWindow x:Class="TPMapEditor.Dialogs.StarmapExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TPMapEditor.Dialogs"
        xmlns:converter="clr-namespace:TPMapEditor.Converter"
        mc:Ignorable="d"
        Title="StarmapExportDialog" SizeToContent="WidthAndHeight">
    <Window.Resources>
        <converter:CenteringMultiConverter x:Key="CenteringMultiConverter"/>
    </Window.Resources>
    <Grid Margin="15">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Viewbox Stretch="Uniform" StretchDirection="Both" Width="512" Height="512">
                <Grid ClipToBounds="True">
                    <Grid x:Name="MapGrid" UseLayoutRounding="False" Margin="{Binding NegativeWorldBuffer}" Width="{Binding Map.Size}" Height="{Binding Map.Size}" Background="Gray">
                        <ItemsControl ItemsSource="{Binding BlackHoles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style>
                                    <Setter Property="Canvas.Left">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                <Binding Path="X" />
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Canvas.Bottom">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                <Binding Path="Y" />
                                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid RenderTransformOrigin="{Binding Type.Pivot}">
                                        <Grid.RenderTransform>
                                            <RotateTransform Angle="{Binding ZRotation}"/>
                                        </Grid.RenderTransform>
                                        <Image Source="{Binding Type.Image}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding StarmapWorldObjects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style>
                                    <Setter Property="Canvas.Left">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                <Binding Path="X" />
                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Canvas.Bottom">
                                        <Setter.Value>
                                            <MultiBinding Converter="{StaticResource CenteringMultiConverter}">
                                                <Binding Path="Y" />
                                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid RenderTransformOrigin="{Binding Type.Pivot}">
                                        <Grid.RenderTransform>
                                            <RotateTransform Angle="{Binding ZRotation}"/>
                                        </Grid.RenderTransform>
                                        <Image Source="{Binding Type.Image}" Visibility="Hidden" Margin="0" Stretch="Uniform" StretchDirection="Both"/>
                                        <Rectangle Fill="White" Margin="-10">
                                            <Rectangle.OpacityMask>
                                                <ImageBrush ImageSource="{Binding Type.Image}" Stretch="Uniform"/>
                                            </Rectangle.OpacityMask>
                                            <Rectangle.Effect>
                                                <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="50" Opacity="1"/>
                                            </Rectangle.Effect>
                                        </Rectangle>
                                        <Rectangle Fill="Black" Margin="-5">
                                            <Rectangle.OpacityMask>
                                                <ImageBrush ImageSource="{Binding Type.Image}" Stretch="Uniform"/>
                                            </Rectangle.OpacityMask>
                                            <Rectangle.Effect>
                                                <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="50" Opacity="1"/>
                                            </Rectangle.Effect>
                                        </Rectangle>
                                        <Rectangle Fill="Turquoise" Margin="0">
                                            <Rectangle.OpacityMask>
                                                <ImageBrush ImageSource="{Binding Type.Image}" Stretch="Uniform"/>
                                            </Rectangle.OpacityMask>
                                            <Rectangle.Effect>
                                                <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="50" Opacity="1"/>
                                            </Rectangle.Effect>
                                        </Rectangle>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Viewbox>
        </ScrollViewer>
    </Grid>
</local:DialogWindow>
