<local:DialogWindow x:Class="TPMapEditor.Dialogs.WorldInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TPMapEditor.Dialogs"
        xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
        xmlns:data="clr-namespace:TPMapEditor.Data"
        xmlns:controls="clr-namespace:TPMapEditor.Controls"
        xmlns:settings="clr-namespace:TPMapEditor.Settings"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="WorldInfoDialog" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer>
            <StackPanel>
                <GroupBox Header="World settings">
                    <StackPanel>
                        <ComboBox x:Name="mapTypeComboBox" SelectionChanged="MapTypeComboBox_SelectionChanged" Margin="5">
                            <ComboBoxItem Content="Historical map"/>
                            <ComboBoxItem Content="Open map"/>
                            <ComboBoxItem Content="Campaign map"/>
                            <ComboBoxItem Content="Custom map"/>
                        </ComboBox>
                        <CheckBox x:Name="mustAssembleFleetCheckBox" Margin="5" Content="Must assemble fleet" IsChecked="{Binding Map.MustAssembleFleet}"/>
                        <CheckBox x:Name="isCampaignCheckBox" Margin="5" Content="Is campaign" IsChecked="{Binding Map.IsCampaign}"/>
                        <CheckBox Margin="5" Content="Is alliance change allowed" IsChecked="{Binding Map.IsAllianceChangeAllowed}"/>
                        <CheckBox x:Name="isMultiplayerCheckBox" Margin="5" Content="Is multiplayer" IsChecked="{Binding Map.IsMultiplayer}" IsEnabled="{c:Binding 'Map.Players.Count > 1'}" IsEnabledChanged="IsMultiplayerCheckBox_IsEnabledChanged"/>
                        <CheckBox Margin="5" Content="Islands make sounds" IsChecked="{Binding Map.IslandsMakeSounds}"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Map name" Padding="5">
                    <ComboBox ItemsSource="{x:Static data:StringDictionnary.WorldNames}" SelectedValue="{Binding Map.WorldName}" SelectedValuePath="Key" DisplayMemberPath="Value"/>
                </GroupBox>
                <GroupBox Header="Custom map name">
                    <StackPanel>
                        <CheckBox Margin="5" IsChecked="{Binding Map.UseCustomName}" Content="Use custom name"/>
                        <TextBox Margin="5" IsEnabled="{Binding Map.UseCustomName}" Text="{Binding Map.CustomName}"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Map description" Padding="5">
                    <ComboBox ItemsSource="{x:Static data:StringDictionnary.WorldDescriptions}" SelectedValue="{Binding Map.WorldDescription}" SelectedValuePath="Key" DisplayMemberPath="Value"/>
                </GroupBox>
                <GroupBox Header="Custom map description">
                    <StackPanel>
                        <CheckBox Margin="5" IsChecked="{Binding Map.UseCustomDescription}" Content="Use custom description"/>
                        <TextBox Margin="5" IsEnabled="{Binding Map.UseCustomDescription}" Text="{Binding Map.CustomDescription}"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Padding="5" Header="Skybox">
                    <ComboBox ItemsSource="{x:Static settings:AppSettings.Meshes}" SelectedValue="{Binding Map.Skybox}"/>
                </GroupBox>
                <GroupBox Padding="5" Header="Star map texture">
                    <ComboBox ItemsSource="{x:Static settings:AppSettings.GuiTextures}" SelectedValue="{Binding Map.StarmapTexture}"/>
                </GroupBox>
                <GroupBox Padding="5" Header="Ambient light color">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle>
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="/Images/AlphaBg.png" Stretch="Fill" TileMode="Tile" ViewportUnits="Absolute" ViewboxUnits="RelativeToBoundingBox" Viewport="0,0,10,10" Viewbox="0,0,1,1"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle>
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{Binding Map.AmbientLightColor}"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Button Width="70" Content="Edit" Grid.Column="1" Click="EditMapAmbientLightColor_Click"/>
                    </Grid>
                </GroupBox>
                <GroupBox Padding="5" Header="Roof light color">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle>
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="/Images/AlphaBg.png" Stretch="Fill" TileMode="Tile" ViewportUnits="Absolute" ViewboxUnits="RelativeToBoundingBox" Viewport="0,0,10,10" Viewbox="0,0,1,1"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle>
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{Binding Map.RoofLightColor}"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Button Width="70" Content="Edit" Grid.Column="1" Click="EditMapRoofLightColor_Click"/>
                    </Grid>
                </GroupBox>
                <GroupBox Padding="5" Header="Floor light color">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle>
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="/Images/AlphaBg.png" Stretch="Fill" TileMode="Tile" ViewportUnits="Absolute" ViewboxUnits="RelativeToBoundingBox" Viewport="0,0,10,10" Viewbox="0,0,1,1"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle>
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{Binding Map.FloorLightColor}"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Button Width="70" Content="Edit" Grid.Column="1" Click="EditMapFloorLightColor_Click"/>
                    </Grid>
                </GroupBox>
                <GroupBox Header="Roof light orientation">
                    <StackPanel>
                        <Label Margin="-5,0,0,0" Content="Yaw"/>
                        <Slider Value="{Binding Map.RoofLightOrientationYaw}" Minimum="-180" Maximum="180"/>
                        <Label Margin="-5,5,0,0" Content="Pitch"/>
                        <Slider Value="{Binding Map.RoofLightOrientationPitch}" Minimum="-90" Maximum="90"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Current objective point">
                    <StackPanel>
                        <CheckBox Margin="5" x:Name="HasCurrentObjectivePointCheckBox" Content="Has current objective point" IsChecked="{c:Binding 'Map.CurrentObjectivePoint!=null', Mode=OneWay}"/>
                        <ComboBox Margin="5" ItemsSource="{Binding Map.ObjectivePoints}" SelectedItem="{Binding Map.CurrentObjectivePoint}" IsEnabled="{c:Binding ElementName=HasCurrentObjectivePointCheckBox, Path=IsChecked}" SelectedIndex="{c:Binding ElementName=HasCurrentObjectivePointCheckBox, Path='IsChecked ? 0 : -1', Mode=OneWay}"/>
                        <CheckBox Margin="5" Content="Is current objective point visible on star map" IsChecked="{Binding Map.IsCurrentObjectivePointVisibleOnStarMap}"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Journal title">
                    <ComboBox Margin="5" ItemsSource="{x:Static data:StringDictionnary.JournalTitles}" SelectedValue="{Binding Map.JournalTitle}" SelectedValuePath="Key" DisplayMemberPath="Value"/>
                </GroupBox>
                <GroupBox Header="Journal music">
                    <ComboBox Margin="5" ItemsSource="{x:Static settings:AppSettings.Musics}" SelectedValue="{Binding Map.JournalMusic}"/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
            <Button Content="Close" MinWidth="85" IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</local:DialogWindow>
