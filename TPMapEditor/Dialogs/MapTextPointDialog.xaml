<local:DialogWindow x:Class="TPMapEditor.Dialogs.MapTextPointDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TPMapEditor.Dialogs"
        xmlns:data="clr-namespace:TPMapEditor.Data"
        xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="MapTextPointDialog" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="2*" MinWidth="200"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <DataGrid HeadersVisibility="Column" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding Map.MapTextPoints}" SelectedItem="{Binding SelectedMapTextPoint}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Name}" Header="Name" Width="*"/>
                        <DataGridTemplateColumn MinWidth="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove" Click="RemoveMapTextPoint_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Margin="0,5,0,0" Grid.Row="1" MinWidth="85" Content="Add objective point" Command="{Binding AddMapTextPointCommand}"/>
            </Grid>
            <GridSplitter Grid.Column="1" Margin="5,0,5,0" Width="5" ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="{c:Binding 'SelectedMapTextPoint!=null'}">
                <StackPanel>
                    <Label Margin="-5,0,0,0" Content="Name"/>
                    <TextBox Text="{Binding SelectedMapTextPoint.Name, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                    <Label Margin="-5,5,0,0" Content="Displayed text"/>
                    <ComboBox ItemsSource="{x:Static data:StringDictionnary.MapTextItems}" SelectedValue="{Binding SelectedMapTextPoint.RealText}" SelectedValuePath="Key" DisplayMemberPath="Value"/>
                    <Label Margin="-5,5,0,0" Content="Is visible"/>
                    <CheckBox IsChecked="{Binding SelectedMapTextPoint.Visible}" Content="{Binding SelectedMapTextPoint.Visible}"/>
                    <Label Margin="-5,5,0,0" Content="Position X"/>
                    <Slider Value="{Binding SelectedMapTextPoint.X}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                    <Label Margin="-5,5,0,0" Content="Position Y"/>
                    <Slider Value="{Binding SelectedMapTextPoint.Y}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                    <Label Margin="-5,5,0,0" Content="Position Z"/>
                    <Slider Value="{Binding SelectedMapTextPoint.Z}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
            <Button Content="Close" MinWidth="85" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</local:DialogWindow>
