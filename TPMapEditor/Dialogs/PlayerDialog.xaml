<local:DialogWindow x:Class="TPMapEditor.Dialogs.PlayerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converter="clr-namespace:TPMapEditor.Converter"
        xmlns:local="clr-namespace:TPMapEditor.Dialogs"
        xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
        xmlns:enums="clr-namespace:TPMapEditor.Enums"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="PlayerDialog" Height="450" Width="800">
    <Window.Resources>
        <converter:TeamNameConverter x:Key="teamNameConverter"/>
        
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="2*" MinWidth="200"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <DataGrid HeadersVisibility="Column" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding Map.Players}" SelectedItem="{Binding SelectedPlayer}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Name}" Header="Name" Width="*"/>
                        <DataGridTemplateColumn MinWidth="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove" Click="RemovePlayer_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Margin="0,5,0,0" Grid.Row="1" MinWidth="85" Content="Add player" Command="{Binding AddPlayerCommand}"/>
            </Grid>
            <GridSplitter Grid.Column="1" Margin="5,0,5,0" Width="5" ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="{c:Binding 'SelectedPlayer!=null'}">
                <StackPanel>
                    <Label Margin="-5,0,0,0" Content="Name"/>
                    <TextBox Text="{Binding SelectedPlayer.Name, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/>
                    <Label Margin="-5,5,0,0" Content="Is playable"/>
                    <CheckBox Content="{Binding SelectedPlayer.IsPlayable}" IsChecked="{Binding SelectedPlayer.IsPlayable}" IsEnabled="{c:Binding 'Map.PlayerPlayableCount less 8 or SelectedPlayer.IsPlayable'}"/>
                    <Label Margin="-5,5,0,0" Content="Color"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle>
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="/Images/AlphaBg.png" Stretch="Fill" TileMode="Tile" ViewportUnits="Absolute" ViewboxUnits="RelativeToBoundingBox" Viewport="0,0,10,10" Viewbox="0,0,1,1"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle>
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{Binding SelectedPlayer.Color}"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Button Width="70" Content="Edit" Grid.Column="1" Click="EditPlayerColor_Click"/>
                    </Grid>
                    <Label Margin="-5,5,0,0" Content="Position X"/>
                    <Slider Value="{Binding SelectedPlayer.X}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                    <Label Margin="-5,5,0,0" Content="Position Y"/>
                    <Slider Value="{Binding SelectedPlayer.Y}" IsSnapToTickEnabled="True" SmallChange="1" Minimum="-9999" Maximum="9999"/>
                    <Label Margin="-5,5,0,0" Content="Rotation"/>
                    <Slider Value="{Binding SelectedPlayer.Rotation}" Maximum="180" Minimum="-180" TickFrequency="1" AutoToolTipPlacement="TopLeft" SmallChange="1" LargeChange="15"/>
                    <Label Margin="-5,5,0,0" Content="Formation type start"/>
                    <ComboBox SelectedItem="{Binding SelectedPlayer.FormationTypeStart}" ItemsSource="{enums:EnumBindingSource enums:FormationType}"/>
                    <CheckBox x:Name="PlayerHasSelectableTeamCheckBox" Margin="0,15,0,0" Content="Has selectable team ?" IsChecked="{c:Binding Path='SelectedPlayer.SelectableTeam != null', Mode=OneWay}"/>
                    <Label Margin="-5,5,0,0" Content="Selectable team"/>
                    <ComboBox
                        SelectedItem="{Binding SelectedPlayer.SelectableTeam}"
                        ItemsSource="{Binding Map.SelectableTeams}"
                        IsEnabled="{Binding ElementName=PlayerHasSelectableTeamCheckBox, Path=IsChecked}"
                        SelectedIndex="{c:Binding ElementName=PlayerHasSelectableTeamCheckBox, Path='IsChecked ? 0 : -1', Mode=OneWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RealName, Converter={StaticResource teamNameConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox x:Name="PlayerHasInGameTeamCheckBox" Margin="0,15,0,0" Content="Has in game team ?" IsChecked="{c:Binding Path='SelectedPlayer.InGameTeam != null', Mode=OneWay}"/>
                    <Label Margin="-5,5,0,0" Content="In game team"/>
                    <ComboBox
                        SelectedItem="{Binding SelectedPlayer.InGameTeam}"
                        ItemsSource="{Binding Map.InGameTeams}"
                        IsEnabled="{Binding ElementName=PlayerHasInGameTeamCheckBox, Path=IsChecked}"
                        SelectedIndex="{c:Binding ElementName=PlayerHasInGameTeamCheckBox, Path='IsChecked ? 0 : -1', Mode=OneWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RealName, Converter={StaticResource teamNameConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
            <Button Content="Close" MinWidth="85" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</local:DialogWindow>
