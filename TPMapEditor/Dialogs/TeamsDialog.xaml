<local:DialogWindow x:Class="TPMapEditor.Dialogs.TeamsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TPMapEditor.Dialogs"
        xmlns:enums="clr-namespace:TPMapEditor.Enums"
        xmlns:controls="clr-namespace:TPMapEditor.Controls"
        xmlns:data="clr-namespace:TPMapEditor.Data"
        mc:Ignorable="d"
        Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="Selectable teams">
                <Grid Margin="3">
                    <controls:CollectionEditorControl ItemsSource="{Binding SelectableTeams}" SelectedItems="{Binding SelectedSelectableTeams}" Factory="{Binding Factory}" GridOnlyMode="True" CopyCommand="{Binding CopySelectableTeamsCommand}" PasteCommand="{Binding PasteSelectableTeamsCommand}">
                        <controls:CollectionEditorControl.Columns>
                            <DataGridTemplateColumn Header="Team name" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding Item.RealName, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{x:Static data:StringDictionnary.TeamNames}" SelectedValuePath="Key" DisplayMemberPath="Value"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Race" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding Item.Race, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{enums:EnumBindingSource enums:Race}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Race locked" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Item.RaceLocked, UpdateSourceTrigger=PropertyChanged}" Content="{Binding Item.RaceLocked, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </controls:CollectionEditorControl.Columns>
                    </controls:CollectionEditorControl>
                </Grid>
            </TabItem>
            <TabItem Header="In game teams">
                <Grid Margin="3">
                    <controls:CollectionEditorControl ItemsSource="{Binding InGameTeams}" SelectedItems="{Binding SelectedInGameTeams}" Factory="{Binding Factory}" GridOnlyMode="True" CopyCommand="{Binding CopyInGameTeamsCommand}" PasteCommand="{Binding PasteInGameTeamsCommand}">
                        <controls:CollectionEditorControl.Columns>
                            <DataGridTemplateColumn Header="Team name" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding Item.RealName, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{x:Static data:StringDictionnary.TeamNames}" SelectedValuePath="Key" DisplayMemberPath="Value"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Race" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding Item.Race, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{enums:EnumBindingSource enums:Race}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Race locked" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Item.RaceLocked, UpdateSourceTrigger=PropertyChanged}" Content="{Binding Item.RaceLocked, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </controls:CollectionEditorControl.Columns>
                    </controls:CollectionEditorControl>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
            <Button Content="Close" MinWidth="85" IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</local:DialogWindow>
