<local:DialogWindow x:Class="TPMapEditor.Dialogs.WorldCrewAndArmsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:data="clr-namespace:TPMapEditor.Data"
        xmlns:local="clr-namespace:TPMapEditor.Dialogs"
        xmlns:converter="clr-namespace:TPMapEditor.Converter"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="WorldCrewAndArmsDialog" Height="450" Width="800">
    <Window.Resources>
        <converter:WotTypesToCrewTypesConverter x:Key="WotTypesToCrewTypesConverter"/>
        <converter:WotTypesToGunTypesConverter x:Key="WotTypesToGunTypesConverter"/>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="World crews">
                <Grid Margin="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Margin="0,0,5,0" MinWidth="85" Content="Add crew" Command="{Binding AddWorldCrewCommand}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Source={x:Static data:WorldObjectType.WotTypes}, Converter={StaticResource WotTypesToCrewTypesConverter}}" SelectedValue="{Binding SelectedCrewType}"/>
                    </Grid>
                    <DataGrid Grid.Row="1" HeadersVisibility="Column" ItemsSource="{Binding Map.WorldCrews}" SelectedItem="{Binding SelectedWorldCrew}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" IsReadOnly="True"/>
                            <DataGridTemplateColumn MinWidth="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Click="RemoveWorldCrew_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="World arms">
                <Grid Margin="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Margin="0,0,5,0" MinWidth="85" Content="Add crew" Command="{Binding AddWorldArmCommand}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Source={x:Static data:WorldObjectType.WotTypes}, Converter={StaticResource WotTypesToGunTypesConverter}}" SelectedValue="{Binding SelectedArmType}"/>
                    </Grid>
                    <DataGrid Grid.Row="1" HeadersVisibility="Column" ItemsSource="{Binding Map.WorldArms}" SelectedItem="{Binding SelectedWorldArm}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" IsReadOnly="True"/>
                            <DataGridTemplateColumn MinWidth="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Click="RemoveWorldArm_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
            <Button Content="Close" MinWidth="85" IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</local:DialogWindow>
