<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
                    xmlns:converter="clr-namespace:TPMapEditor.Converter"
                    xmlns:dialogs="clr-namespace:TPMapEditor.Dialogs">
    <ControlTemplate x:Key="CollectionEditorControlFullGrid" TargetType="{x:Type dialogs:CollectionEditorControl}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <Button MinWidth="85" Content="Add" Command="{Binding AddCommand}"/>
            </StackPanel>
            <DataGrid Style="{StaticResource DataGridNoSelectedForeground}" HeadersVisibility="Column" Grid.Column="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn MinWidth="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove" Command="{Binding RelativeSource={RelativeSource AncestorType=dialogs:CollectionEditorControl}, Path=RemoveCommand}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="CollectionEditorControlNotFullGrid" TargetType="{x:Type dialogs:CollectionEditorControl}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="2*" MinWidth="200"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <DataGrid HeadersVisibility="Column" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Objects" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn MinWidth="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove" Command="{Binding RelativeSource={RelativeSource AncestorType=dialogs:CollectionEditorControl}, Path=DataContext.RemoveCommand}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Margin="0,5,0,0" Grid.Row="1" MinWidth="85" Content="Add" Command="{Binding AddCommand}"/>
                <StackPanel Grid.Column="1">
                    <Button Margin="5,0,0,0" Width="25" Command="{Binding MoveUpCommand}">
                        <Image Source="/Images/ArrowUp.png"/>
                    </Button>
                    <Button Margin="5,5,0,0" Width="25" Command="{Binding MoveDownCommand}">
                        <Image Source="/Images/ArrowDown.png"/>
                    </Button>
                </StackPanel>
            </Grid>
            <GridSplitter Grid.Column="1" Margin="5,0,5,0" Width="5" ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
            <ScrollViewer Grid.Column="2" Visibility="{c:Binding 'SelectedItem!=null'}" VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding SelectedItem.Item}"/>
            </ScrollViewer>
        </Grid>
    </ControlTemplate>
    <Style TargetType="{x:Type dialogs:CollectionEditorControl}">
        <Setter Property="Template" Value="{StaticResource CollectionEditorControlNotFullGrid}"/>
        <Style.Triggers>
            <Trigger Property="GridOnlyMode" Value="True">
                <Setter Property="Template" Value="{StaticResource CollectionEditorControlFullGrid}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>