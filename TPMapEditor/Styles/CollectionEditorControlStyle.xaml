<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converter="clr-namespace:TPMapEditor.Converter"
                    xmlns:controls="clr-namespace:TPMapEditor.Controls">
    <ControlTemplate x:Key="CollectionEditorControlFullGrid" TargetType="{x:Type controls:CollectionEditorControl}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="Button_Column" Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <Button x:Name="PART_AddButton" MinWidth="85" Content="Add"/>
                <Button x:Name="PART_DeleteSelectedButton" MinWidth="85" Margin="0,5,0,0" Content="Remove selected"/>
                <Button x:Name="PART_MoveUpButton" Margin="0,5,0,0" Width="25" HorizontalAlignment="Right">
                    <Image Source="/Images/ArrowUp.png"/>
                </Button>
                <Button x:Name="PART_MoveDownButton" Margin="0,5,0,0" Width="25" HorizontalAlignment="Right">
                    <Image Source="/Images/ArrowDown.png"/>
                </Button>
            </StackPanel>
            <DataGrid x:Name="PART_DataGrid" Style="{StaticResource DataGridNoSelectedForeground}" HeadersVisibility="All" CanUserResizeRows="False" RowHeaderWidth="25" RowHeight="25" Grid.Column="1" ItemsSource="{TemplateBinding Wrappers}" SelectedItem="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedItem, Mode=TwoWay}" CanUserAddRows="False" AutoGenerateColumns="False" SelectionMode="Extended" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Objects" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Margin="4,0,0,0" Text="{Binding Display}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="CollectionEditorControlNotFullGrid" TargetType="{x:Type controls:CollectionEditorControl}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="2*" MinWidth="200"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <DataGrid x:Name="PART_DataGrid" HeadersVisibility="Column" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" ItemsSource="{TemplateBinding Wrappers}" SelectedItem="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedItem, Mode=TwoWay}" SelectionMode="Extended" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Objects" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="4,0,0,0" Text="{Binding Display}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1">
                    <Button x:Name="PART_AddButton" Margin="0,5,0,0" MinWidth="85" Content="Add"/>
                    <Button x:Name="PART_DeleteSelectedButton" Margin="0,5,0,0" MinWidth="85" Content="Remove selected"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <Button x:Name="PART_MoveUpButton" Margin="5,0,0,0" Width="25">
                        <Image Source="/Images/ArrowUp.png"/>
                    </Button>
                    <Button x:Name="PART_MoveDownButton" Margin="5,5,0,0" Width="25">
                        <Image Source="/Images/ArrowDown.png"/>
                    </Button>
                </StackPanel>
            </Grid>
            <GridSplitter Grid.Column="1" Margin="5,0,5,0" Width="5" ShowsPreview="True" ResizeBehavior="PreviousAndNext"/>
            <ContentControl Grid.Column="2" x:Name="PART_SelectedItemContentControl" Content="{TemplateBinding SelectedItem}"/>
        </Grid>
    </ControlTemplate>
    <Style TargetType="{x:Type controls:CollectionEditorControl}">
        <Setter Property="Template" Value="{StaticResource CollectionEditorControlNotFullGrid}"/>
        <Style.Triggers>
            <Trigger Property="GridOnlyMode" Value="True">
                <Setter Property="Template" Value="{StaticResource CollectionEditorControlFullGrid}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>